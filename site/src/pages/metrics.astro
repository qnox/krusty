---
// The public metrics page. Its data comes from scripts/metrics.mjs over the directory the `pages`
// workflow fills each night (KRUSTY_METRICS_INPUT); without one, every section says it was not
// measured instead of showing a number.
import Base from "../layouts/Base.astro";
import { collectMetrics } from "../../scripts/metrics.mjs";

const repo = "https://github.com/qnox/krusty";
const title = "krusty metrics: byte equality, conformance, build time and memory";
const description =
  "How krusty compares with kotlinc today, regenerated every night: byte-identical class files on real open-source projects and on Kotlin's codegen/box suite, box conformance per Kotlin version, compile time, peak memory and test coverage.";
const metrics = collectMetrics(process.env.KRUSTY_METRICS_INPUT);
const { box, corpus, coverage } = metrics;
const generated = new Date().toISOString().replace(/\.\d+Z$/, "Z").replace("T", " ");

// Round down to one decimal, so a near miss never shows as 100.0%.
const pct = (count: number, of: number) => (of === 0 ? "—" : `${(Math.floor((count * 1000) / of) / 10).toFixed(1)}%`);
const n = (value: number) => value.toLocaleString("en-US");
const share = (count: number, of: number) => `${n(count)} / ${n(of)}`;
const short = (sha: string) => sha.slice(0, 7);
const day = (iso: string) => iso.slice(0, 10);
const seconds = (value: number | null | undefined) => (value ? `${value.toFixed(1)} s` : "—");
const mb = (value: number | null | undefined) => (value ? `${n(value)} MB` : "—");
const commitUrl = (sha: string) => `${repo}/commit/${sha}`;
const newest = box?.versions[0];

// Kotlin's codegen/box suite is reported per Kotlin version; byte totals are .class bytes.
const boxCell = (report: { passed?: number; applicable?: number; matched?: number; total?: number } | null, bytes = false) => {
  if (!report) return { main: "not reported", detail: "" };
  const count = bytes ? report.matched! : report.passed!;
  const of = bytes ? report.total! : report.applicable!;
  return { main: pct(count, of), detail: bytes ? `${n(count)} of ${n(of)} bytes` : `${n(count)} of ${n(of)} cases` };
};

// The trend: one point per nightly corpus run, the share of classes and of compilations krusty
// matched or built. Both are shares of 100, so they share one axis.
// Only runs that measured as many projects as the corpus lists now are comparable; a manual run of
// a few projects is left to the table of every run.
const history = corpus?.history ?? [];
const fullSize = corpus?.projects.length ?? 0;
const runs = history.filter((r) => r.projects === fullSize).slice(-60);
const chart = { width: 680, height: 220, left: 40, right: 112, top: 12, bottom: 28 };
const plotW = chart.width - chart.left - chart.right;
const plotH = chart.height - chart.top - chart.bottom;
const series = [
  { key: "identical", label: "Identical classes", value: (r: any) => (r.classes ? (100 * r.identical) / r.classes : 0) },
  { key: "built", label: "Compilations built", value: (r: any) => (r.compilations ? (100 * r.built) / r.compilations : 0) },
];
const top = Math.max(10, Math.ceil(Math.max(0, ...runs.flatMap((r) => series.map((s) => s.value(r)))) / 10) * 10);
const x = (i: number) => chart.left + (runs.length <= 1 ? plotW / 2 : (i * plotW) / (runs.length - 1));
const y = (v: number) => chart.top + plotH - (v / top) * plotH;
const ticks = [0, top / 2, top];
const paths = series.map((s) => ({
  ...s,
  d: runs.map((r, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)},${y(s.value(r)).toFixed(1)}`).join(""),
  last: runs.length ? s.value(runs[runs.length - 1]) : 0,
}));
const points = runs.map((r, i) => ({
  x: x(i),
  tip: `${r.date} · krusty ${short(r.commit)} · ${r.projects} projects\nIdentical classes: ${share(r.identical, r.classes)} (${pct(r.identical, r.classes)})\nCompilations built: ${share(r.built, r.compilations)} (${pct(r.built, r.compilations)})`,
}));
// A tile's meter shows the share it states, floored like the number beside it.
const meter = (count: number, of: number) => `--value: ${of === 0 ? 0 : Math.floor((count * 1000) / of) / 10}%`;
const tiles = [
  {
    label: "Byte-identical classes",
    scope: "real projects",
    figure: corpus && { count: corpus.total.identical, of: corpus.total.classes, meta: `${share(corpus.total.identical, corpus.total.classes)} classes in ${corpus.projects.length} projects` },
  },
  {
    label: "JVM byte equality",
    scope: newest ? `codegen/box, Kotlin ${newest.version}` : "codegen/box",
    figure: newest?.bytes && { count: newest.bytes.matched, of: newest.bytes.total, meta: `${n(newest.bytes.matched)} of ${n(newest.bytes.total)} .class bytes` },
  },
  {
    label: "JVM conformance",
    scope: newest ? `codegen/box, Kotlin ${newest.version}` : "codegen/box",
    figure: newest?.jvm && { count: newest.jvm.passed, of: newest.jvm.applicable, meta: `${n(newest.jvm.passed)} of ${n(newest.jvm.applicable)} cases pass` },
  },
  {
    label: "Compilations built",
    scope: "real projects",
    figure: corpus && { count: corpus.total.built, of: corpus.total.compilations, meta: `${share(corpus.total.built, corpus.total.compilations)} Kotlin/JVM compilations` },
  },
];
---
<Base title={title} description={description}>
  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Metrics · regenerated nightly</p>
        <h1>Where krusty stands against kotlinc</h1>
        <p>Every number comes from the latest master CI run and the latest nightly corpus run; nothing is picked by hand. A source that could not be read says so instead of showing a number.</p>
        <p class="meta">Generated {generated} UTC · raw data at <a href="/metrics.json">/metrics.json</a></p>
      </div>
      <div class="tiles">
        {tiles.map((t) => (
          <div class="tile">
            <div class="tile-label">{t.label}<span class="scope">{t.scope}</span></div>
            {t.figure ? (
              <>
                <div class="tile-value">{pct(t.figure.count, t.figure.of)}</div>
                <div class="meter" style={meter(t.figure.count, t.figure.of)}><span></span></div>
                <div class="tile-meta">{t.figure.meta}</div>
              </>
            ) : (
              <>
                <div class="tile-value na">—</div>
                <div class="tile-meta">Not measured</div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="byte-equality">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Headline metric</p>
        <h2>Byte equality on real projects</h2>
        <p>krusty aims to emit <code>.class</code> files byte for byte identical to <code>kotlinc</code>'s. An identical class needs no tests to trust: it is exactly what <code>kotlinc</code> would have shipped, which matters most for code with few or no tests. A class counts only when the whole file matches; every class of a compilation krusty could not build counts as different.</p>
        <p>Each project is built from a pinned commit with its own Gradle build, once with <code>kotlinc</code> and once with the krusty Gradle plugin. Where a project needs changes to build with the Kotlin release krusty targets, the patch is linked as applied. Reasons for every missed compilation are in the <a href={`${repo}/tree/corpus-results`}><code>corpus-results</code></a> report.</p>
      </div>
      {corpus ? (
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>Project</th><th class="num">Identical classes</th><th class="num">Compilations built</th><th>Reference build</th><th>Patch</th><th>Measured</th></tr>
            </thead>
            <tbody>
              {corpus.projects.map((p) => (
                <tr>
                  <td>{p.source ? <a href={`${p.source.url}/tree/${p.source.commit}`}>{p.name}</a> : p.name}{p.kotlinLoc !== null && <div class="sub">{n(p.kotlinLoc)} Kotlin lines</div>}</td>
                  <td class="num">{pct(p.identical, p.classes)}<div class="sub">{share(p.identical, p.classes)}</div></td>
                  <td class="num">{share(p.built, p.compilations)}</td>
                  <td>{p.referenceBuild === "ok" ? "ok" : <span class="bad">{p.referenceBuild}</span>}</td>
                  <td>
                    {!p.source || !p.measured ? <span class="na">not recorded yet</span>
                      : p.source.patch ? <a href={`${repo}/blob/${p.measured.commit}/${p.source.patch}`}>{p.source.patch.split("/").pop()}</a>
                      : "none"}
                    {p.source?.kotlin_pin && <div class="sub">Kotlin version set in <code>{p.source.kotlin_pin.split(":")[0]}</code></div>}
                  </td>
                  <td class="nowrap">{p.measured ? <a href={p.measured.run}>{p.measured.date}</a> : "—"}{p.measured && <div class="sub">krusty <a href={commitUrl(p.measured.commit)}>{short(p.measured.commit)}</a></div>}</td>
                </tr>
              ))}
              <tr class="total">
                <td>Total</td>
                <td class="num">{pct(corpus.total.identical, corpus.total.classes)}<div class="sub">{share(corpus.total.identical, corpus.total.classes)}</div></td>
                <td class="num">{share(corpus.total.built, corpus.total.compilations)}</td>
                <td></td><td></td><td></td>
              </tr>
            </tbody>
          </table>
        </div>
      ) : <p class="na">Not measured: no nightly corpus result was available when this page was built.</p>}
    </div>
  </section>

  <section class="band" id="trend">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Over time</p>
        <h2>Trend</h2>
        <p>Identical classes and compilations built, as a share of everything the projects compile. One point per corpus run that measured all {fullSize} listed projects; partial runs are in the table below.</p>
      </div>
      {runs.length > 0 ? (
        <figure class="chart">
          <div class="legend" aria-hidden="true"><span><i class="key s1"></i>Identical classes</span><span><i class="key s2"></i>Compilations built</span></div>
          <svg viewBox={`0 0 ${chart.width} ${chart.height}`} role="img" aria-labelledby="trend-title">
            <title id="trend-title">Share of identical classes and of compilations built across the last {runs.length} full corpus runs</title>
            {ticks.map((t) => (
              <g class="grid">
                <line x1={chart.left} x2={chart.left + plotW} y1={y(t)} y2={y(t)} />
                <text x={chart.left - 6} y={y(t) + 4} text-anchor="end">{t}%</text>
              </g>
            ))}
            <line class="baseline" x1={chart.left} x2={chart.left + plotW} y1={y(0)} y2={y(0)} />
            <text class="axis" x={chart.left} y={chart.height - 6}>{runs[0].date}</text>
            <text class="axis" x={chart.left + plotW} y={chart.height - 6} text-anchor="end">{runs[runs.length - 1].date}</text>
            {paths.map((s, i) => (
              <g class={`series s${i + 1}`}>
                <path d={s.d} />
                <circle cx={x(runs.length - 1)} cy={y(s.last)} r="4" />
                <text x={x(runs.length - 1) + 8} y={y(s.last) + 4 + (i === 1 && Math.abs(y(paths[0].last) - y(s.last)) < 14 ? 14 : 0)}>{s.last.toFixed(1)}% {s.key === "identical" ? "classes" : "built"}</text>
              </g>
            ))}
            <line class="cursor" x1="0" x2="0" y1={chart.top} y2={chart.top + plotH} />
            {points.map((p) => (
              <rect class="hit" x={p.x - plotW / Math.max(1, runs.length - 1) / 2} y={chart.top} width={Math.max(8, plotW / Math.max(1, runs.length - 1))} height={plotH} data-x={p.x} data-tip={p.tip}>
                <title>{p.tip}</title>
              </rect>
            ))}
          </svg>
          <div class="tooltip" hidden></div>
        </figure>
      ) : <p class="na">No full corpus run recorded yet.</p>}
      {history.length > 0 && (
        <details>
          <summary>Every corpus run ({history.length})</summary>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Date</th><th>krusty</th><th class="num">Projects</th><th class="num">Identical classes</th><th class="num">Compilations built</th></tr></thead>
              <tbody>
                {[...history].reverse().map((r) => (
                  <tr>
                    <td><a href={r.run}>{r.date}</a></td>
                    <td><a href={commitUrl(r.commit)}>{short(r.commit)}</a></td>
                    <td class="num">{r.projects}</td>
                    <td class="num">{pct(r.identical, r.classes)}<div class="sub">{share(r.identical, r.classes)}</div></td>
                    <td class="num">{share(r.built, r.compilations)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}
    </div>
  </section>

  <section class="band" id="box">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Kotlin's own test suite</p>
        <h2>codegen/box conformance</h2>
        {box ? (
          <p>Every applicable case of JetBrains' <code>codegen/box</code> tests, compiled by krusty and by the matching <code>kotlinc</code>. Conformance counts cases whose <code>box()</code> returns <code>"OK"</code>; byte equality counts the <code>.class</code> bytes of classes identical to <code>kotlinc</code>'s. From the <a href={box.run.url}>master CI run</a> of {day(box.run.date)}, krusty <a href={commitUrl(box.run.commit)}>{short(box.run.commit)}</a>.</p>
        ) : <p class="na">Not measured: no successful master CI run with box reports was available when this page was built.</p>}
      </div>
      {box && (
        <div class="table-scroll">
          <table>
            <thead><tr><th>Kotlin</th><th class="num">JVM byte equality</th><th class="num">JVM conformance</th><th class="num">Native conformance</th></tr></thead>
            <tbody>
              {box.versions.map((v) => (
                <tr>
                  <td>{v.version}</td>
                  {[boxCell(v.bytes, true), boxCell(v.jvm), boxCell(v.native)].map((c) => (
                    <td class="num">{c.main}<div class="sub">{c.detail}</div></td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>

  <section class="band" id="cost">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Time and memory</p>
        <h2>Compile time and peak RSS</h2>
        <p>The same two builds of each project, each alone on its own runner, after a warm-up build; both run offline from the same caches. The fair speed comparison is the compile time of the compilations krusty built, since <code>kotlinc</code> compiles the rest in both builds. Compiler RSS is the Kotlin daemon's peak in the reference build and krusty's in the other; build RSS sums every process, Gradle included.</p>
      </div>
      {corpus ? (
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>Project</th><th class="num">Compile time of what krusty built<div class="sub">kotlinc / krusty</div></th><th class="num">Compiler peak RSS<div class="sub">kotlinc / krusty</div></th><th class="num">Build peak RSS<div class="sub">kotlinc / krusty</div></th><th class="num">Build wall time<div class="sub">kotlinc / krusty</div></th></tr>
            </thead>
            <tbody>
              {corpus.projects.map((p) => {
                const k = p.cost.kotlinc;
                const r = p.cost.krusty;
                if (!k || !r) return <tr><td>{p.name}</td><td colspan="4" class="na">not measured</td></tr>;
                return (
                  <tr>
                    <td>{p.name}</td>
                    <td class="num">{p.built ? `${seconds(k.builtCompileSeconds)} / ${seconds(r.builtCompileSeconds)}` : <span class="na">nothing built</span>}</td>
                    <td class="num">{mb(k.compilerPeakRssMb)} / {mb(r.compilerPeakRssMb)}</td>
                    <td class="num">{mb(k.buildPeakRssMb)} / {mb(r.buildPeakRssMb)}</td>
                    <td class="num">{seconds(k.wallSeconds)} / {seconds(r.wallSeconds)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : <p class="na">Not measured: no nightly corpus result was available when this page was built.</p>}
      <p class="pending"><strong>Compiler benchmark:</strong> not measured yet. A fixed benchmark of krusty's own compile time and peak RSS, independent of Gradle, is being set up and will appear here.</p>
    </div>
  </section>

  <section class="band" id="tests">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Behaviour</p>
        <h2>Project test suites</h2>
        <p class="pending">Not measured yet. Running each project's own tests against the classes krusty built is being set up and will appear here, per project, as tests passed out of tests run.</p>
      </div>
    </div>
  </section>

  <section class="band" id="coverage">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">krusty itself</p>
        <h2>Test coverage</h2>
        {coverage ? (
          <p>How much of krusty's own source its test suite exercises, as recorded by the coverage gate every change must pass (<a href={`${repo}/blob/master/coverage-baseline.json`}><code>coverage-baseline.json</code></a>).</p>
        ) : <p class="na">Not measured.</p>}
      </div>
      {coverage && (
        <div class="table-scroll narrow">
          <table>
            <thead><tr><th>Measure</th><th class="num">Covered</th><th class="num">Of</th><th class="num">Share</th></tr></thead>
            <tbody>
              {(["lines", "functions", "regions", "branches"] as const).map((kind) => (
                <tr><td>{kind[0].toUpperCase() + kind.slice(1)}</td><td class="num">{n(coverage[kind].covered)}</td><td class="num">{n(coverage[kind].count)}</td><td class="num">{pct(coverage[kind].covered, coverage[kind].count)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>

  <section class="band" id="sources">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Method</p>
        <h2>How this page is made</h2>
        <p>The <a href={`${repo}/blob/master/.github/workflows/pages.yml`}><code>pages</code> workflow</a> rebuilds it every night, after each nightly corpus run and after every release. It reads the box reports of the latest successful master <a href={`${repo}/actions/workflows/ci.yml`}>CI run</a>, the results the <a href={`${repo}/actions/workflows/oss-corpus.yml`}>corpus run</a> publishes to <a href={`${repo}/tree/corpus-results`}><code>corpus-results</code></a>, and the coverage baseline. A malformed report stops the deploy rather than publish a wrong number.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Hover: a cursor line and a tooltip with the run's numbers. Without script, each column keeps its
  // native <title> tooltip and the table of runs lists every number.
  for (const figure of document.querySelectorAll<HTMLElement>("figure.chart")) {
    const svg = figure.querySelector("svg")!;
    const cursor = svg.querySelector<SVGLineElement>(".cursor")!;
    const tooltip = figure.querySelector<HTMLElement>(".tooltip")!;
    for (const hit of svg.querySelectorAll<SVGRectElement>(".hit")) {
      hit.querySelector("title")?.remove();
      hit.addEventListener("pointerenter", () => {
        const x = hit.dataset.x!;
        cursor.setAttribute("x1", x);
        cursor.setAttribute("x2", x);
        cursor.style.opacity = "1";
        tooltip.textContent = hit.dataset.tip!;
        tooltip.hidden = false;
        const scale = svg.getBoundingClientRect().width / svg.viewBox.baseVal.width;
        tooltip.style.left = `${Math.max(0, Math.min(Number(x) * scale - tooltip.offsetWidth / 2, figure.clientWidth - tooltip.offsetWidth))}px`;
      });
    }
    svg.addEventListener("pointerleave", () => {
      tooltip.hidden = true;
      cursor.style.opacity = "0";
    });
  }
</script>

<style>
  h1 { font-size: var(--step-3); }
  .meta { font-size: var(--step--1); }
  .na, .pending { color: var(--muted); }
  .pending { margin-top: 1.25rem; max-width: var(--measure); }
  .bad { color: var(--bad); }
  .sub { font-size: 0.8rem; color: var(--muted); font-weight: 400; letter-spacing: 0; text-transform: none; }
  .num { text-align: right; white-space: nowrap; }
  .nowrap { white-space: nowrap; }
  .total td { font-weight: 650; background: var(--sunken); }
  .tile-label { display: grid; gap: 0.1rem; }
  .scope { font-size: var(--step--1); font-weight: 400; color: var(--muted); }
  .tile-value.na { color: var(--muted); }
  .narrow { max-width: var(--measure); }
  details { margin-top: 1.25rem; }
  details .table-scroll { margin-top: 0.75rem; }
  summary { cursor: pointer; color: var(--accent); font-weight: 500; }
  .chart { position: relative; margin: 0; padding: 1rem 1rem 0.5rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .chart svg { width: 100%; height: auto; display: block; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: var(--step--1); color: var(--muted); margin-bottom: 0.5rem; }
  .key { display: inline-block; width: 14px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 0.4rem; }
  .key.s1, .s1 circle { background: var(--series-1); fill: var(--series-1); }
  .key.s2, .s2 circle { background: var(--series-2); fill: var(--series-2); }
  .s1 path { stroke: var(--series-1); }
  .s2 path { stroke: var(--series-2); }
  .grid line { stroke: var(--grid); stroke-width: 1; }
  .baseline { stroke: var(--axis); stroke-width: 1; }
  .chart text { fill: var(--muted); font: 12px var(--font-body); font-variant-numeric: tabular-nums; }
  .series path { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .series text { fill: var(--fg); }
  .series circle { stroke: var(--surface); stroke-width: 2; }
  .cursor { stroke: var(--axis); stroke-width: 1; opacity: 0; pointer-events: none; }
  .hit { fill: transparent; }
  .tooltip { position: absolute; top: 2.25rem; white-space: pre; font-size: var(--step--1); line-height: 1.45; background: var(--surface); color: var(--fg); border: 1px solid var(--line); border-radius: var(--radius-small); padding: 0.4rem 0.6rem; pointer-events: none; box-shadow: 0 4px 14px rgb(0 0 0 / 0.12); font-variant-numeric: tabular-nums; }
</style>
