---
// The public metrics page. Its data comes from scripts/metrics.mjs over the directory the `pages`
// workflow fills each night (KRUSTY_METRICS_INPUT); without one, every section says it was not
// measured instead of showing a number.
import Base from "../layouts/Base.astro";
import { collectMetrics } from "../../scripts/metrics.mjs";

const repo = "https://github.com/qnox/krusty";
const title = "krusty metrics: byte equality, conformance, build time and memory";
const description =
  "How krusty compares with kotlinc today, regenerated every night: byte-identical class files on real open-source projects, Kotlin's codegen/box suite per Kotlin version, build time, peak memory and test coverage.";
const { box, corpus, coverage } = collectMetrics(process.env.KRUSTY_METRICS_INPUT);
const generated = new Date().toISOString().replace(/\.\d+Z$/, "Z").replace("T", " ");

// Every share is floored to one decimal, so a near miss never shows as 100.0% and the tiles, tables
// and charts always print the same figure.
const tenths = (count: number, of: number) => (of === 0 ? 0 : Math.floor((count * 1000) / of) / 10);
const pct = (count: number, of: number) => (of === 0 ? "—" : `${tenths(count, of).toFixed(1)}%`);
const n = (value: number) => value.toLocaleString("en-US");
const share = (count: number, of: number) => `${n(count)} / ${n(of)}`;
const short = (sha: string) => sha.slice(0, 7);
const day = (iso: string) => iso.slice(0, 10);
const seconds = (value: number) => `${value.toFixed(1)} s`;
const mb = (value: number) => `${n(value)} MB`;
const commitUrl = (sha: string) => `${repo}/commit/${sha}`;
// krusty's figure relative to kotlinc's: "−62%" is 62% less time or memory than kotlinc.
const change = (kotlinc: number, krusty: number) => {
  if (!kotlinc || !krusty) return null;
  const delta = Math.round(((krusty - kotlinc) / kotlinc) * 100);
  return { text: delta === 0 ? "±0%" : `${delta > 0 ? "+" : "−"}${Math.abs(delta)}%`, worse: delta > 0 };
};
const newest = box?.versions[0];


// The corpus run that measured the projects: one caption when they share it, per row otherwise.
const measuredRuns = new Set((corpus?.projects ?? []).map((p) => p.measured?.run ?? ""));
const commonMeasured = measuredRuns.size === 1 ? corpus?.projects[0]?.measured ?? null : null;

const tileRows = [
  {
    heading: "Real projects",
    note: corpus ? `${corpus.projects.length} open-source projects built with their own Gradle builds` : "",
    tiles: [
      {
        label: "Byte-identical classes",
        figure: corpus && { count: corpus.total.identical, of: corpus.total.classes, meta: `${share(corpus.total.identical, corpus.total.classes)} classes match kotlinc's exactly` },
      },
      {
        label: "Compilations krusty built",
        figure: corpus && { count: corpus.total.built, of: corpus.total.compilations, meta: `${share(corpus.total.built, corpus.total.compilations)} Kotlin/JVM compilations` },
      },
    ],
  },
  {
    heading: "Kotlin's codegen/box suite",
    note: newest ? `Kotlin ${newest.version}, the newest supported release` : "",
    tiles: [
      {
        label: "JVM byte-equality gauge",
        figure: newest?.bytes && { count: newest.bytes.matched, of: newest.bytes.total, meta: `${n(newest.bytes.matched)} of ${n(newest.bytes.total)} .class bytes before the first difference` },
      },
      {
        label: "JVM conformance",
        figure: newest?.jvm && { count: newest.jvm.passed, of: newest.jvm.applicable, meta: `${n(newest.jvm.passed)} of ${n(newest.jvm.applicable)} cases return OK` },
      },
    ],
  },
];

// The trend: small multiples, one chart per measure with its own scale, one point per corpus run
// that measured as many projects as the corpus lists now (a manual run of a few projects is not
// comparable and stays in the table of every run).
const history = corpus?.history ?? [];
const fullSize = corpus?.projects.length ?? 0;
const runs = history.filter((r) => r.projects === fullSize).slice(-60);
const frame = { width: 480, height: 190, left: 44, right: 16, top: 12, bottom: 28 };
const plotW = frame.width - frame.left - frame.right;
const plotH = frame.height - frame.top - frame.bottom;
const xAt = (i: number) => frame.left + (runs.length <= 1 ? plotW / 2 : (i * plotW) / (runs.length - 1));
const niceTop = (max: number) => {
  for (const step of [1, 2, 5, 10, 20, 25, 50, 100]) if (max * 1.15 <= step) return step;
  return 100;
};
const dateTicks = runs.length <= 1 ? [0] : [...new Set([0, Math.round((runs.length - 1) / 3), Math.round((2 * (runs.length - 1)) / 3), runs.length - 1])];
const charts = [
  { id: "identical", label: "Byte-identical classes", series: 1, count: (r: any) => r.identical, of: (r: any) => r.classes, unit: "classes" },
  { id: "built", label: "Compilations krusty built", series: 2, count: (r: any) => r.built, of: (r: any) => r.compilations, unit: "compilations" },
].map((c) => {
  const values = runs.map((r) => tenths(c.count(r), c.of(r)));
  const top = niceTop(Math.max(0, ...values));
  const yAt = (v: number) => frame.top + plotH - (v / top) * plotH;
  return {
    ...c,
    top,
    yAt,
    ticks: [0, top / 2, top],
    d: values.map((v, i) => `${i === 0 ? "M" : "L"}${xAt(i).toFixed(1)},${yAt(v).toFixed(1)}`).join(""),
    points: runs.map((r, i) => ({
      x: xAt(i),
      y: yAt(values[i]),
      tip: `${r.date} · krusty ${short(r.commit)}\n${c.label}: ${pct(c.count(r), c.of(r))} (${share(c.count(r), c.of(r))} ${c.unit})`,
    })),
  };
});
const slot = plotW / Math.max(1, runs.length - 1);
---
<Base title={title} description={description}>
  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Metrics · regenerated nightly</p>
        <h1>Where krusty stands against kotlinc</h1>
        <p>Every number comes from automated runs; nothing is picked by hand. A source that could not be read says so instead of showing a number.</p>
      </div>
      {tileRows.map((row) => (
        <div class="tile-row">
          <h2 class="row-head">{row.heading}{row.note && <span>{row.note}</span>}</h2>
          <div class="tiles">
            {row.tiles.map((t) => (
              <article class="tile">
                <h3 class="tile-label">{t.label}</h3>
                {t.figure ? (
                  <>
                    <p class="tile-value">{pct(t.figure.count, t.figure.of)}</p>
                    <div class="meter" role="img" aria-label={pct(t.figure.count, t.figure.of)} style={`--value: ${tenths(t.figure.count, t.figure.of)}%`}><span /></div>
                    <p class="tile-meta">{t.figure.meta}</p>
                  </>
                ) : (
                  <>
                    <p class="tile-value na">—</p>
                    <p class="tile-meta">Not measured</p>
                  </>
                )}
              </article>
            ))}
          </div>
        </div>
      ))}
      <dl class="sources">
        <div><dt>Real projects</dt><dd>{commonMeasured ? <><a href={commonMeasured.run}>corpus run of {commonMeasured.date}</a>, krusty <a href={commitUrl(commonMeasured.commit)}>{short(commonMeasured.commit)}</a></> : corpus ? "several corpus runs, per project below" : "not measured"}</dd></div>
        <div><dt>codegen/box</dt><dd>{box ? <><a href={box.run.url}>master CI run of {day(box.run.date)}</a>, krusty <a href={commitUrl(box.run.commit)}>{short(box.run.commit)}</a></> : "not measured"}</dd></div>
        <div><dt>Page</dt><dd>generated {generated} UTC · <a href="/metrics.json">raw data</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="band" id="byte-equality">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Headline metric</p>
        <h2>Byte-identical classes on real projects</h2>
        <p>krusty aims to emit <code>.class</code> files byte for byte identical to <code>kotlinc</code>'s. An identical class needs no tests to trust: it is exactly what <code>kotlinc</code> would have shipped, which matters most for code with few or no tests. A class counts only when the whole file matches.</p>
        <p>Each project is built from a pinned commit with its own Gradle build, once with <code>kotlinc</code> and once with the krusty Gradle plugin. A <em>compilation</em> is one Kotlin/JVM compile task of the reference build, main and test source sets alike. krusty <em>built</em> it when it compiled it itself. When it did not, every class of that compilation counts as different, and the reason is one of: <strong>left to kotlinc</strong> (the build uses a compiler plugin or argument krusty does not implement yet, so the plugin hands the task to kotlinc), <strong>failed</strong> (krusty reported an error), or <strong>not run</strong> (a task it depends on failed first). The <a href={`${repo}/tree/corpus-results`}><code>corpus-results</code></a> report lists every reason.</p>
      </div>
      {corpus ? (
        <div class="table-scroll">
          <table class="table-sticky table-compact">
            <thead>
              <tr><th>Project</th><th class="num">Identical classes</th><th class="num">Built</th><th>Not built</th><th>Patch</th>{!commonMeasured && <th>Measured</th>}</tr>
            </thead>
            <tbody>
              {corpus.projects.map((p) => (
                <tr>
                  <td>
                    {p.source ? <a href={`${p.source.url}/tree/${p.source.commit}`}>{p.name}</a> : p.name}
                    {p.kotlinLoc !== null && <div class="sub nowrap">{n(p.kotlinLoc)} Kotlin lines</div>}
                    {p.referenceBuild !== "ok" && <div class="sub bad">kotlinc build {p.referenceBuild}{p.measured && <> · <a href={p.measured.run}>logs</a></>}</div>}
                  </td>
                  <td class="num">{pct(p.identical, p.classes)}<div class="sub">{share(p.identical, p.classes)}</div></td>
                  <td class="num">{share(p.built, p.compilations)}</td>
                  <td class="reasons">
                    {p.notBuilt ? (
                      [["leftToKotlinc", "left to kotlinc"], ["failed", "failed"], ["notRun", "not run"]]
                        .filter(([key]) => p.notBuilt[key] > 0)
                        .map(([key, label]) => <span>{p.notBuilt[key]} {label}</span>)
                    ) : <span class="na">—</span>}
                  </td>
                  <td>
                    {p.source?.patch && p.measured ? <a href={`${repo}/blob/${p.measured.commit}/${p.source.patch}`}>{p.source.patch.split("/").pop()}</a> : !p.source ? <span class="na">not recorded</span> : null}
                  </td>
                  {!commonMeasured && <td class="nowrap">{p.measured ? <a href={p.measured.run}>{p.measured.date}</a> : "—"}</td>}
                </tr>
              ))}
              <tr class="total">
                <td>Total</td>
                <td class="num">{pct(corpus.total.identical, corpus.total.classes)}<div class="sub">{share(corpus.total.identical, corpus.total.classes)}</div></td>
                <td class="num">{share(corpus.total.built, corpus.total.compilations)}</td>
                <td></td><td></td>{!commonMeasured && <td></td>}
              </tr>
            </tbody>
          </table>
        </div>
      ) : <p class="na">Not measured: no nightly corpus result was available when this page was built.</p>}
      {corpus && <p class="fine">Totals include every listed project, also one whose own kotlinc build failed: its compilations count as far as the kotlinc build produced classes. Every project is built with the newest Kotlin release krusty supports; a linked patch is what the corpus changes to make that build work, applied to both builds.</p>}
    </div>
  </section>

  <section class="band" id="trend">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Over time</p>
        <h2>Trend</h2>
        <p>One point per corpus run that measured all {fullSize} listed projects, each measure on its own scale. Partial runs are in the table below.</p>
      </div>
      {runs.length > 0 ? (
        <div class="charts">
          {charts.map((c) => (
            <figure class="chart">
              <figcaption><i class={`key s${c.series}`}></i>{c.label}</figcaption>
              <svg viewBox={`0 0 ${frame.width} ${frame.height}`} role="img" aria-label={`${c.label} per corpus run, from ${runs[0].date} to ${runs[runs.length - 1].date}`}>
                {c.ticks.map((t) => (
                  <>
                    <line class="grid" x1={frame.left} x2={frame.left + plotW} y1={c.yAt(t)} y2={c.yAt(t)} />
                    <text x={frame.left - 6} y={c.yAt(t) + 4} text-anchor="end">{t}%</text>
                  </>
                ))}
                <line class="axis" x1={frame.left} x2={frame.left + plotW} y1={c.yAt(0)} y2={c.yAt(0)} />
                {dateTicks.map((i, k) => (
                  <text x={xAt(i)} y={frame.height - 8} text-anchor={k === 0 && dateTicks.length > 1 ? "start" : i === runs.length - 1 && runs.length > 1 ? "end" : "middle"}>{runs[i].date.slice(5)}</text>
                ))}
                <path class={`line s${c.series}`} d={c.d} />
                {c.points.map((p) => <circle class={`dot s${c.series}`} cx={p.x} cy={p.y} r="3" />)}
                <line class="cursor" x1="0" x2="0" y1={frame.top} y2={frame.top + plotH} />
                {c.points.map((p) => (
                  <rect class="hit" x={p.x - Math.max(8, slot) / 2} y={frame.top} width={Math.max(8, slot)} height={plotH} data-x={p.x} data-tip={p.tip}>
                    <title>{p.tip}</title>
                  </rect>
                ))}
              </svg>
              <p class="tooltip" aria-hidden="true">{c.points[c.points.length - 1].tip}</p>
            </figure>
          ))}
        </div>
      ) : <p class="na">No full corpus run recorded yet.</p>}
      {history.length > 0 && (
        <details>
          <summary>Every corpus run ({history.length})</summary>
          <div class="table-scroll">
            <table class="table-sticky table-compact">
              <thead><tr><th>Date</th><th>krusty</th><th class="num">Projects</th><th class="num">Identical classes</th><th class="num">Built</th></tr></thead>
              <tbody>
                {[...history].reverse().map((r) => (
                  <tr>
                    <td class="nowrap"><a href={r.run}>{r.date}</a></td>
                    <td><a href={commitUrl(r.commit)}>{short(r.commit)}</a></td>
                    <td class="num">{r.projects}</td>
                    <td class="num">{pct(r.identical, r.classes)}<div class="sub">{share(r.identical, r.classes)}</div></td>
                    <td class="num">{share(r.built, r.compilations)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}
    </div>
  </section>

  <section class="band" id="cost">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Time and memory</p>
        <h2>Build time and peak RSS</h2>
        <p>The same two builds of each project, each alone on its own runner after a warm-up build, both offline from the same caches. Each cell shows krusty's build against kotlinc's: <span class="good">−40%</span> means 40% less. Whole builds are compared only where both did the same work: both Gradle builds succeeded and krusty compiled something with no compilation failed or skipped. Elsewhere one build stopped early or ran different tasks, so its numbers are shown but marked not comparable; results recorded before the corpus kept the build outcomes are marked comparability unknown. Whole-build wall time barely moves yet, because krusty builds only {corpus ? pct(corpus.total.built, corpus.total.compilations) : "a share"} of the compilations: kotlinc still compiles the rest in the krusty build, and Gradle's own work is the same in both. Compile time of what krusty built compares only the compilations krusty compiled itself. Compiler RSS is the Kotlin daemon's peak in the kotlinc build and krusty's in the other; where krusty built little, the Kotlin daemon still runs in the krusty build, so build RSS is the fairer memory figure.</p>
      </div>
      {corpus ? (
        <div class="table-scroll">
          <table class="table-sticky table-compact">
            <thead>
              <tr><th>Project</th><th class="num">Build wall time</th><th class="num">Build peak RSS</th><th class="num">Compile time, what krusty built</th><th class="num">Compiler peak RSS</th></tr>
            </thead>
            <tbody>
              {corpus.projects.map((p) => {
                const k = p.cost.kotlinc;
                const r = p.cost.krusty;
                if (!k || !r) return <tr><td>{p.name}</td><td colspan="4" class="na">not measured</td></tr>;
                // Whole builds get a change only when they did the same work (metrics.mjs decides);
                // otherwise their raw values stay, muted, marked not comparable or unknown.
                const sameWork = p.wholeBuildsComparable;
                const cell = (kv: number, rv: number, unit: (v: number) => string, comparable: boolean | null) => {
                  const c = comparable === true ? change(kv, rv) : null;
                  const why = comparable === true ? "—" : comparable === false ? "not comparable" : "comparability unknown";
                  return <td class="num">{c ? <span class={c.worse ? "bad" : "good"}>{c.text}</span> : <span class="na">{why}</span>}<div class="sub">{unit(kv)} → {unit(rv)}</div></td>;
                };
                return (
                  <tr>
                    <td>{p.name}</td>
                    {cell(k.wallSeconds, r.wallSeconds, seconds, sameWork)}
                    {cell(k.buildPeakRssMb, r.buildPeakRssMb, mb, sameWork)}
                    {p.built ? cell(k.builtCompileSeconds, r.builtCompileSeconds, seconds, true) : <td class="num na">nothing built</td>}
                    {cell(k.compilerPeakRssMb, r.compilerPeakRssMb, mb, sameWork)}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : <p class="na">Not measured: no nightly corpus result was available when this page was built.</p>}
    </div>
  </section>

  <section class="band" id="box">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Kotlin's own test suite</p>
        <h2>codegen/box per Kotlin version</h2>
        {box ? (
          <p>Every applicable case of JetBrains' <code>codegen/box</code> tests, compiled by krusty and by the matching <code>kotlinc</code>. <strong>Conformance</strong> is the share of cases whose <code>box()</code> returns <code>"OK"</code>. The <strong>byte-equality gauge</strong> is a progress measure, not a share of identical classes: each class counts its bytes before the first difference from <code>kotlinc</code>'s, over the longer of the two files, and a failing case counts zero; 100% means every class is identical. See <a href={`${repo}/blob/master/docs/TEST_HARNESS.md`}>docs/TEST_HARNESS.md</a>.</p>
        ) : <p class="na">Not measured: no successful master CI run with box reports was available when this page was built.</p>}
      </div>
      {box && (
        <div class="table-scroll">
          <table class="table-sticky table-compact">
            <thead><tr><th>Kotlin</th><th class="num">JVM byte-equality gauge</th><th class="num">JVM conformance</th><th class="num">Native conformance</th></tr></thead>
            <tbody>
              {box.versions.map((v) => (
                <tr>
                  <td>{v.version}</td>
                  {[
                    v.bytes && { count: v.bytes.matched, of: v.bytes.total, unit: "bytes" },
                    v.jvm && { count: v.jvm.passed, of: v.jvm.applicable, unit: "cases" },
                    v.native && { count: v.native.passed, of: v.native.applicable, unit: "cases" },
                  ].map((c) => (
                    <td class="num">{c ? <>{pct(c.count, c.of)}<div class="sub">{n(c.count)} of {n(c.of)} {c.unit}</div></> : <span class="na">not reported</span>}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>

  <section class="band" id="coverage">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">krusty itself</p>
        <h2>Coverage floor of krusty's own tests</h2>
        {coverage ? (
          <p>The share of krusty's own source its test suite exercises, as the floor the coverage gate enforces on every change (<a href={`${repo}/blob/master/coverage-baseline.json`}><code>coverage-baseline.json</code></a>). The measured coverage of a change is at least this.</p>
        ) : <p class="na">Not measured.</p>}
      </div>
      {coverage && (
        <div class="table-scroll narrow">
          <table class="table-compact">
            <thead><tr><th>Measure</th><th class="num">Covered</th><th class="num">Of</th><th class="num">Share</th></tr></thead>
            <tbody>
              {(["lines", "functions", "regions", "branches"] as const).map((kind) => (
                <tr><td>{kind[0].toUpperCase() + kind.slice(1)}</td><td class="num">{n(coverage[kind].covered)}</td><td class="num">{n(coverage[kind].count)}</td><td class="num">{pct(coverage[kind].covered, coverage[kind].count)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>

  <section class="band" id="next">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Not measured yet</p>
        <h2>Coming next</h2>
      </div>
      <ul class="next">
        <li><strong>Project test suites:</strong> each project's own tests run against the classes krusty built, as tests passed out of tests run.</li>
        <li><strong>Compiler benchmark:</strong> krusty's own compile time and peak RSS on a fixed workload, independent of Gradle.</li>
      </ul>
      <p class="fine">The <a href={`${repo}/blob/master/.github/workflows/pages.yml`}><code>pages</code> workflow</a> rebuilds this page every night, after each nightly corpus run and after every release, from the latest successful master <a href={`${repo}/actions/workflows/ci.yml`}>CI run</a>, the <a href={`${repo}/tree/corpus-results`}><code>corpus-results</code></a> branch and the coverage baseline. A malformed report stops the deploy rather than publish a wrong number.</p>
    </div>
  </section>
</Base>

<script>
  // Hover or tap: a cursor line on the chart and the run's numbers in the line below it. Without
  // script the line shows the latest run, each column keeps its native tooltip, and the table of
  // runs lists every number.
  for (const figure of document.querySelectorAll<HTMLElement>("figure.chart")) {
    const cursor = figure.querySelector<SVGLineElement>(".cursor")!;
    const tooltip = figure.querySelector<HTMLElement>(".tooltip")!;
    const latest = tooltip.textContent;
    for (const hit of figure.querySelectorAll<SVGRectElement>(".hit")) {
      hit.querySelector("title")?.remove();
      hit.addEventListener("pointerenter", () => {
        cursor.setAttribute("x1", hit.dataset.x!);
        cursor.setAttribute("x2", hit.dataset.x!);
        cursor.style.opacity = "1";
        tooltip.textContent = hit.dataset.tip!;
      });
    }
    figure.querySelector("svg")!.addEventListener("pointerleave", () => {
      cursor.style.opacity = "0";
      tooltip.textContent = latest;
    });
  }
</script>

<style>
  h1 { font-size: var(--step-3); }
  .na { color: var(--muted); }
  .bad { color: var(--bad); }
  .good { color: var(--ok); }
  .sub { font-size: 0.8rem; color: var(--muted); }
  .nowrap { white-space: nowrap; }
  .fine { margin-top: 1rem; max-width: var(--measure); font-size: var(--step--1); color: var(--muted); }
  .total td { font-weight: 650; background: var(--sunken); }
  .narrow { max-width: var(--measure); }
  .tile-row + .tile-row { margin-top: 1.75rem; }
  .row-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; font-size: var(--step-1); margin-bottom: 0.75rem; }
  .row-head span { font: 400 var(--step--1) / 1.4 var(--font-body); color: var(--muted); letter-spacing: 0; }
  .tile-label { font-size: var(--step--1); color: var(--muted); font-family: var(--font-body); }
