---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Base from "../layouts/Base.astro";
import { gist, readFigure } from "../lib/figures";

const repo = "https://github.com/qnox/krusty";
const release = `${repo}/releases/latest`;
const blob = (path: string) => `${repo}/blob/master/${path}`;
const title = "krusty: a Kotlin compiler written in Rust";
const description =
  "krusty is a Kotlin compiler written in Rust. Built as a drop-in replacement for kotlinc on the JVM: for the supported Kotlin subset, kotlinc-compatible flags and .class files that aim to be byte-for-byte identical to kotlinc's.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "krusty",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: Astro.site?.href,
  codeRepository: repo,
  downloadUrl: release,
  // Google picks a result thumbnail from structured data before guessing from the page.
  image: new URL("/card.png", Astro.site).href,
};

// kotlin-versions is the single source of truth for the supported Kotlin releases.
const kotlinVersions = readFileSync(resolve(process.cwd(), "../kotlin-versions"), "utf8")
  .split("\n")
  .map((line) => line.trim().split(/\s+/)[0])
  .filter((version) => version && !version.startsWith("#"));
const newestKotlin = kotlinVersions[kotlinVersions.length - 1];

const figures = [
  {
    id: "conformance",
    file: "krusty-conformance.json",
    label: "JVM conformance",
    unit: "cases pass",
    explain: "Cases whose box() returns OK on krusty's bytecode. CI fails on any applicable JVM case that does not pass.",
  },
  {
    id: "bytes",
    file: "krusty-jvm-byte-equality.json",
    label: "JVM byte equality",
    unit: "class-file bytes match",
    explain: "A progress gauge, not a share of identical classes: each class counts only its bytes before the first difference from kotlinc's. 100% means every class is identical.",
  },
  {
    id: "native",
    file: "krusty-native-conformance.json",
    label: "Native conformance",
    unit: "cases pass",
    experimental: true,
    explain: "Native-applicable cases that compile against the Kotlin/Native stdlib, link, run and return OK.",
  },
];
const values = await Promise.all(figures.map((figure) => readFigure(figure.file)));
const fmt = (n: number) => n.toLocaleString("en-US");

type Level = "yes" | "partial" | "no";
const levelLabel: Record<Level, string> = { yes: "Supported", partial: "Partial", no: "Not supported" };

const buildSystems: { name: string; level: Level; html: string }[] = [
  {
    name: "Command line",
    level: "yes",
    html: "kotlinc-compatible flags for the supported subset; output to a class directory or a jar. Compiler plugins come in through <code>-Xplugin</code>/<code>-P</code>/<code>-Xcompiler-plugin</code> as for kotlinc.",
  },
  {
    name: "Gradle",
    level: "yes",
    html: `<code>id("dev.krustythecompiler")</code> plugin, shipped as <code>krusty-gradle-plugin-&lt;version&gt;.zip</code> in each <a href="${release}">release</a>. Replaces the Kotlin/JVM compile tasks of source sets and of Android variants (AGP 9's built-in Kotlin or <code>kotlin("android")</code>). Validated with Gradle 7.6.3, 8.14.3, 9.5.0 and 9.7.0. <code>kotlin-dsl</code> builds such as <code>buildSrc</code> and compile tasks outside a source set stay with kotlinc, logged per task.`,
  },
  {
    name: "Kotlin Toolchain (project.yaml/module.yaml)",
    level: "partial",
    html: `<code>krusty-toolchain</code>, built from source, as a drop-in for JetBrains' <code>kotlin</code> command. JVM modules only; a module with Java sources, a compiler setting it does not pass yet or an artifact to download is refused by name. See <a href="${blob("docs/KOTLIN_TOOLCHAIN.md")}">docs/KOTLIN_TOOLCHAIN.md</a>.`,
  },
  {
    name: "Kotlin Build Tools API",
    level: "partial",
    html: `<code>krusty-build-tools-&lt;version&gt;-kotlin-&lt;kotlin&gt;.jar</code> in each release stands in for <code>kotlin-build-tools-impl</code> in a build tool that loads the API from a classpath. JVM toolchain and in-process execution only. See <a href="${blob("tools/krusty-build-tools/README.md")}">tools/krusty-build-tools</a>.`,
  },
  {
    name: "Bazel",
    level: "yes",
    html: `<code>krusty_jvm_library</code> rule from the <code>krusty</code> Bazel module each release publishes, with the release's compiler as a toolchain per host and a <code>--persistent_worker</code>. The worker accepts no compiler plugins. See <a href="${blob("tools/krusty-bazel/README.md")}">tools/krusty-bazel</a>.`,
  },
  {
    name: "Maven",
    level: "partial",
    html: `Verification only: the <code>krusty-maven-plugin</code> <code>verify</code> goal compiles each compilation with krusty beside kotlinc's output and reports how krusty fares. kotlinc still builds what Maven ships. See <a href="${blob("tools/krusty-maven/README.md")}">tools/krusty-maven</a>.`,
  },
];

const plugins: { name: string; level: Level; html: string }[] = [
  { name: "kotlinx.serialization", level: "yes", html: "Conformance is measured against the plugin's own box-test corpus." },
  { name: "all-open (plugin.allopen, plugin.spring, plugin.jpa)", level: "yes", html: "Including the <code>spring</code> and <code>jpa</code> presets." },
  { name: "no-arg (plugin.noarg, plugin.jpa)", level: "partial", html: "Including the <code>jpa</code> preset; <code>invokeInitializers=true</code> is not implemented." },
  { name: "sam-with-receiver", level: "yes", html: "" },
  {
    name: "KSP (KSP2)",
    level: "partial",
    html: "Through a build system. Under Gradle, KSP's own <code>kspKotlin</code> task runs the processors and krusty compiles what they generate (Gradle 8 or newer). Under the Kotlin Toolchain, only generated classes and resources are picked up. The plain command line rejects KSP.",
  },
  {
    name: "kapt",
    level: "partial",
    html: "Under Gradle: kapt's own tasks run the annotation processors with kotlinc, then krusty compiles the module. kapt options on the command line fail with an error.",
  },
  {
    name: "Compose, Parcelize, assignment and every other FIR/IR plugin",
    level: "no",
    html: "The command line fails with an error. The Gradle plugin reports the plugin and leaves that compile task to kotlinc, so the build still succeeds.",
  },
  { name: "Kotlin scripts (.kts)", level: "no", html: "" },
];
---
<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="band hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Kotlin/JVM compiler · written in Rust</p>
        <h1>A Kotlin compiler that aims to match kotlinc <span class="rust">byte for byte.</span></h1>
        <p class="lede">
          krusty is a native binary, written in Rust, that takes <code>kotlinc</code>'s command-line flags and writes
          JVM <code>.class</code> files. Every change is diffed against the real kotlinc. It needs no JVM to run.
        </p>
        <p class="fit">
          <strong>Use it today for</strong> Kotlin/JVM modules, Android ones included, built with Gradle, Bazel or the
          command line. Under Gradle, a module that needs Compose, Parcelize or another plugin krusty does not implement
          stays on kotlinc, and the plugin logs which task and why.
        </p>
        <div class="actions">
          <a class="button button-primary" href="#try">Try it on your build</a>
          <a class="button" href={release}>Download the latest release</a>
        </div>
        <ul class="hero-meta">
          <li>Kotlin {kotlinVersions.join(", ")}</li>
          <li>Linux, macOS, Windows · x86_64, arm64</li>
          <li>Signed releases · Apache-2.0</li>
        </ul>
      </div>
      <picture class="hero-art">
        <source srcset="/krusty.avif" type="image/avif" />
        <img src="/krusty.png" alt="krusty, a crab mascot" width="480" height="311" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section class="band band-alt" id="measured" aria-labelledby="measured-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Kotlin {newestKotlin} · latest master build</p>
        <h2 id="measured-title">Measured against kotlinc's own tests</h2>
        <p>
          Every master build compiles Kotlin's <code>codegen/box</code> test suite with krusty and with
          kotlinc {newestKotlin}, the newest supported release. A case passes when its <code>box()</code> function returns
          <code>OK</code>. Cases the suite marks as not running on a target are left out of that target's figures.
        </p>
      </div>
      <div class="tiles">
        {figures.map((figure, i) => {
          const value = values[i];
          return (
            <article class="tile figure" data-file={figure.file} data-unit={figure.unit}>
              <h3 class="tile-label">{figure.label}{figure.experimental && <span class="tag">Experimental</span>}</h3>
              <p class="tile-value" data-part="value">{value ? `${value.pct}%` : "–"}</p>
              <div class="meter" role="img" aria-label={value ? `${value.pct}%` : "not available"} style={`--value: ${value ? value.pct : 0}%`}>
                <span />
              </div>
              <p class="tile-meta" data-part="meta">
                {value ? `${fmt(value.count)} of ${fmt(value.of)} ${figure.unit}` : "Loading the latest figure"}
              </p>
              <p class="figure-explain">{figure.explain}</p>
            </article>
          );
        })}
      </div>
      <p class="fine">
        How each figure is counted: <a href={blob("docs/TEST_HARNESS.md")}>docs/TEST_HARNESS.md</a>. Other suites
        (kotlinx.serialization, KSP and the rest) are correctness gates and count toward none of these figures.
      </p>
    </div>
  </section>

  <section class="band" id="install" aria-labelledby="install-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">Install</p>
        <h2 id="install-title">One binary on your PATH</h2>
        <ol class="steps">
          <li>Download the archive for your platform from the <a href={release}>latest release</a>.</li>
          <li>Extract <code>krusty</code> and put it on your <code>PATH</code>.</li>
          <li>Have a JDK installed. krusty does not run on the JVM, but it reads the JDK's class library (<code>JAVA_HOME</code> or <code>-jdk-home &lt;dir&gt;</code>).</li>
        </ol>
      </div>
      <div class="prose code-col">
        <p class="eyebrow">Usage</p>
        <pre><code><span class="c"># compile a source tree to a class directory</span>
krusty src/ -d out/
<span class="c"># or to a jar</span>
krusty src/ -d mylib.jar -module-name mylib
<span class="c"># with a classpath</span>
krusty -cp deps.jar:classes/ App.kt -d out/
<span class="c"># all options</span>
krusty -help</code></pre>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="try" aria-labelledby="try-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">Gradle</p>
        <h2 id="try-title">Find out if krusty fits your build before you switch</h2>
        <p>
          The Gradle plugin's <code>krustyVerify</code> task compiles every Kotlin/JVM compilation with kotlinc, as your
          build does today, and with krusty beside it. Nothing you ship changes.
        </p>
        <p>
          The report in <code>build/reports/krusty-verify/</code> lists which compilations krusty handles and which it
          leaves to kotlinc and why, how many classes are byte-identical to kotlinc's and how the rest differ, and
          both compilers' compile time and krusty's peak memory.
        </p>
        <p class="fine">
          The report has a button that opens a prefilled GitHub issue with totals and difference kinds, with
          compilation, class and member names masked. Sending it tells us what to fix next.
        </p>
      </div>
      <div class="prose code-col">
        <p class="step-label">1. Unpack <code>krusty-gradle-plugin-&lt;version&gt;.zip</code> from the <a href={release}>latest release</a> under <code>gradle/</code></p>
        <pre><code><span class="c">// settings.gradle.kts</span>
pluginManagement {'{'}
    repositories {'{'}
        maven {'{'} url = uri("gradle/krusty-gradle-plugin-&lt;version&gt;/repository") {'}'}
        gradlePluginPortal()
        mavenCentral()
    {'}'}
{'}'}</code></pre>
        <p class="step-label">2. Apply it after your Kotlin or Android plugin</p>
        <pre><code><span class="c">// build.gradle.kts</span>
plugins {'{'}
    kotlin("jvm") version "{newestKotlin}"
    id("dev.krustythecompiler") version "&lt;version&gt;"
{'}'}</code></pre>
        <p class="step-label">3. Compare, without changing your build</p>
        <pre><code>./gradlew krustyVerify</code></pre>
        <p class="fine">Signature checks, Android, multiplatform and mirrors are covered in <a href={`${repo}#gradle`}>the Gradle guide</a>.</p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="why-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why krusty</p>
        <h2 id="why-title">What you get today</h2>
      </div>
      <ul class="points">
        <li>
          <h3>Fails loudly</h3>
          <p>On the command line, an unsupported flag or plugin is an error, never silently skipped. Under Gradle it is logged and that task stays on kotlinc.</p>
        </li>
        <li>
          <h3>Diffed against kotlinc</h3>
          <p>Every change is compared with the real kotlinc's output, and every master build runs Kotlin's <code>codegen/box</code> suite.</p>
        </li>
        <li>
          <h3>Less memory</h3>
          <p>On our multi-module benchmark, about a third of the peak memory of the GraalVM-native kotlinc.</p>
        </li>
        <li>
          <h3>Verifiable releases</h3>
          <p>Checksums signed with the maintainer's OpenPGP key and GitHub build provenance on every release file. The Gradle plugin checks the signature before it runs a compiler.</p>
        </li>
        <li>
          <h3>Editor support</h3>
          <p>The <code>krusty-lsp</code> language server, with a <a href={blob("editors/zed/README.md")}>Zed extension</a>.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="band" id="support" aria-labelledby="support-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Compatibility</p>
        <h2 id="support-title">Build systems and compiler plugins</h2>
        <p>
          krusty targets every Kotlin release in <a href={blob("kotlin-versions")}><code>kotlin-versions</code></a>.
          On the command line, anything not listed here fails the build with an error. The Gradle plugin reports it and
          leaves that compile task to kotlinc.
        </p>
      </div>

      <ul class="legend" aria-label="Status key">
        <li><span class="chip chip-yes">Supported</span> krusty replaces kotlinc there.</li>
        <li><span class="chip chip-partial">Partial</span> Works within the limits listed.</li>
        <li><span class="chip chip-no">Not supported</span> The command line fails; Gradle keeps kotlinc for that task.</li>
      </ul>

      <h3 class="table-title">Build systems</h3>
      <div class="table-scroll">
        <table class="support">
          <thead><tr><th scope="col">Build system</th><th scope="col">Status</th><th scope="col">Details</th></tr></thead>
          <tbody>
            {buildSystems.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                <td><span class={`chip chip-${row.level}`}>{levelLabel[row.level]}</span></td>
                <td set:html={row.html} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="table-title">Compiler plugins</h3>
      <p class="table-intro">
        krusty cannot run kotlinc's FIR/IR plugin jars. It reimplements the plugins below natively and selects them from
        the same jar and options kotlinc receives, so a build switches compilers without changing its plugin
        configuration.
      </p>
      <div class="table-scroll">
        <table class="support">
          <thead><tr><th scope="col">Plugin</th><th scope="col">Status</th><th scope="col">Details</th></tr></thead>
          <tbody>
            {plugins.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                <td><span class={`chip chip-${row.level}`}>{levelLabel[row.level]}</span></td>
                <td set:html={row.html} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="roadmap-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">Roadmap</p>
        <h2 id="roadmap-title">Where krusty is going</h2>
        <p>krusty compiles plain Kotlin/JVM code today, through the build systems and with the compiler plugins above. Next:</p>
        <ul class="roadmap">
          <li>100% JVM conformance with kotlinc</li>
          <li>Kotlin/Native</li>
          <li>Kotlin/Wasm</li>
          <li>Compose</li>
        </ul>
      </div>
      <div class="prose sponsor">
        <p class="eyebrow">Sponsor</p>
        <h2>Help fund it</h2>
        <p>krusty is an independent project. If it is useful to your team, please consider sponsoring its development.</p>
        <p><a class="button" href="https://github.com/sponsors/qnox">Sponsor on GitHub</a></p>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ gist }}>
  // Refresh the figures from the same gist the badges read, so a page built days ago still shows
  // the latest master build. On failure the build-time figures stay.
  const pattern = /^(\d+(?:\.\d+)?)% \((\d+)\/(\d+)(?: bytes)?\)$/;
  for (const tile of document.querySelectorAll(".figure")) {
    fetch(gist + tile.dataset.file, { cache: "no-cache" })
      .then((response) => (response.ok ? response.json() : null))
      .then((body) => {
        const match = body && pattern.exec(body.message);
        if (!match) return;
        const [, pct, count, of] = match;
        const fmt = (n) => Number(n).toLocaleString("en-US");
        tile.querySelector('[data-part="value"]').textContent = `${pct}%`;
        tile.querySelector('[data-part="meta"]').textContent = `${fmt(count)} of ${fmt(of)} ${tile.dataset.unit}`;
        const meter = tile.querySelector(".meter");
        meter.style.setProperty("--value", `${pct}%`);
        meter.setAttribute("aria-label", `${pct}%`);
      })
      .catch(() => {});
  }
</script>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem) clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem 3rem;
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .rust {
    color: var(--rust);
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 38rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .fit {
    max-width: 38rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .hero-meta {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .hero-meta li {
    white-space: nowrap;
  }

  .tag {
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font: 600 0.7rem / 1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    vertical-align: 0.2em;
  }

  .step-label {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .legend {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .legend .chip {
    color: var(--fg);
    margin-right: 0.25rem;
  }

  .hero-art img {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
  }

  .figure-explain {
    color: var(--muted);
    font-size: var(--step--1);
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
    margin-top: 0.25rem;
  }

  .fine {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: 1.25rem;
    max-width: var(--measure);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 3rem;
    align-items: start;
  }

  .code-col {
    min-width: 0;
    align-content: start;
  }

  .code-col .fine {
    margin-top: 0;
  }

  .steps {
    display: grid;
    gap: 0.6rem;
  }

  pre .c {
    color: var(--muted);
  }

  .points {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1.5rem 2rem;
  }

  .points li {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    border-top: 2px solid var(--fg);
    padding-top: 0.9rem;
  }

  .points p {
    color: var(--muted);
  }

  .table-title {
    margin: 2rem 0 0.75rem;
  }

  .table-intro {
    max-width: var(--measure);
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .support th[scope="row"] {
    color: var(--fg);
    font: 600 var(--step--1) / 1.5 var(--font-body);
    letter-spacing: 0;
    text-transform: none;
    min-width: 11rem;
  }

  .support td:last-child {
    min-width: 20rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.8rem;
  }

  .chip::before {
    content: "";
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex: none;
  }

  .chip-yes::before {
    background: var(--st-good);
  }

  .chip-partial::before {
    background: var(--st-warn);
  }

  .chip-no::before {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--muted);
  }

  .chip-no {
    color: var(--muted);
  }

  .roadmap {
    display: grid;
    gap: 0.35rem;
  }

  .sponsor {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  @media (max-width: 760px) {
    .hero-grid,
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-art {
      order: -1;
    }

    .hero-art img {
      max-width: 13rem;
