---
const repo = "https://github.com/qnox/krusty";
const title = "krusty: a Kotlin compiler written in Rust";
const description =
  "krusty is a Kotlin compiler written in Rust. A drop-in replacement for kotlinc on the JVM: the same flags, and .class files byte-for-byte identical to kotlinc's.";
const badge = (file: string) =>
  `https://img.shields.io/endpoint?url=https%3A%2F%2Fgist.githubusercontent.com%2Fqnox%2Fdec8149bc4f43b203d6cc9adc14f2026%2Fraw%2F${file}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "krusty",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: Astro.site?.href,
  codeRepository: repo,
  downloadUrl: `${repo}/releases/latest`,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site?.href} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site?.href} />
    <meta property="og:image" content={new URL("/krusty.png", Astro.site).href} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main>
      <picture>
        <source srcset="/krusty.avif" type="image/avif" />
        <img class="mascot" src="/krusty.png" alt="krusty, a crab mascot" width="240" height="156" fetchpriority="high" />
      </picture>
      <h1>krusty</h1>
      <p class="tag">A Kotlin compiler written in Rust.</p>
      <p>
        A drop-in replacement for <code>kotlinc</code> on the JVM: the same command-line flags in, and <code>.class</code> files byte-for-byte identical to <code>kotlinc</code>'s out, from a single native binary.
      </p>
      <p class="badges">
        <img src={badge("krusty-kotlin.json")} alt="Latest supported Kotlin version" height="20" />
        <img src={badge("krusty-conformance.json")} alt="Kotlin codegen/box conformance" height="20" />
      </p>
      <p>
        <a href={`${repo}/releases/latest`}>Download</a> · <a href={repo}>Source</a> · <a href={`${repo}/blob/master/docs/SPEC.md`}>Supported language</a>
      </p>

      <h2>Usage</h2>
      <pre><code>krusty src/ -d out/                          # compile to a class directory
krusty src/ -d mylib.jar -module-name mylib  # or to a jar
krusty -cp deps.jar:classes/ App.kt -d out/  # with a classpath</code></pre>
      <p>
        Binaries for Linux, macOS and Windows (x86_64, arm64) are on every <a href={`${repo}/releases/latest`}>release</a>. From source: <code>cargo build --release -p krusty-cli</code>.
      </p>

      <h2>What it does</h2>
      <ul>
        <li>Output is diffed against the real <code>kotlinc</code>: class files, <code>@kotlin.Metadata</code>, <code>.kotlin_module</code>.</li>
        <li>Every build runs JetBrains' <code>codegen/box</code> suite; the badge shows the pass rate.</li>
        <li>kotlinx.serialization and KSP are supported.</li>
        <li><code>krusty-lsp</code> is a Kotlin language server on the same compiler, with a <a href={`${repo}/tree/master/editors/zed`}>Zed extension</a>.</li>
      </ul>
    </main>
    <footer>
      Apache-2.0 · <a href={repo}>github.com/qnox/krusty</a> · Kotlin is a trademark of JetBrains; krusty is an independent project.
    </footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --fg: #1b1a1f; --muted: #5d5a66; --bg: #fff; --code: #f3f1f6; --accent: #7f52ff; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #ecebf0; --muted: #a09cab; --bg: #131217; --code: #201e27; --accent: #a78bff; }
  }
  body { margin: 0 auto; max-width: 720px; padding: 32px 16px; background: var(--bg); color: var(--fg); font: 17px/1.6 system-ui, sans-serif; }
  .mascot { display: block; width: 240px; height: auto; margin: 0 0 8px -8px; }
  h1 { font-size: 40px; margin: 0; }
  .tag { font-size: 22px; margin: 0 0 16px; color: var(--muted); }
  h2 { margin-top: 36px; font-size: 22px; }
  a { color: var(--accent); }
  code, pre { font: 14.5px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  p code, li code { background: var(--code); padding: 1px 4px; border-radius: 4px; }
  pre { background: var(--code); padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
  .badges img { margin-right: 6px; vertical-align: middle; }
  footer { margin-top: 48px; font-size: 14px; color: var(--muted); }
</style>
