---
import { SEO } from "astro-seo";

const repo = "https://github.com/qnox/krusty";
const news = "https://x.com/qnox";
const xHandle = "@qnox";
const title = "krusty: a Kotlin compiler written in Rust";
const description =
  "krusty is a Kotlin compiler written in Rust. Built as a drop-in replacement for kotlinc on the JVM: for the supported Kotlin subset, kotlinc-compatible flags and .class files that aim to be byte-for-byte identical to kotlinc's.";
// Link-preview card: 1200x630 (X's and Open Graph's 1.91:1 size) so the crawler shows it uncropped.
const card = new URL("/card.png", Astro.site).href;
const cardAlt = "krusty, a crab mascot";
const badge = (file: string) =>
  `https://img.shields.io/endpoint?url=https%3A%2F%2Fgist.githubusercontent.com%2Fqnox%2Fdec8149bc4f43b203d6cc9adc14f2026%2Fraw%2F${file}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "krusty",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: Astro.site?.href,
  codeRepository: repo,
  downloadUrl: `${repo}/releases/latest`,
  // Google picks a result thumbnail from structured data before guessing from the page.
  image: card,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      canonical={Astro.site?.href}
      openGraph={{
        basic: { title, type: "website", image: card, url: Astro.site?.href },
        optional: { description, siteName: "krusty" },
        image: { type: "image/png", width: 1200, height: 630, alt: cardAlt },
      }}
      twitter={{ card: "summary_large_image", site: xHandle, creator: xHandle, title, description, image: card, imageAlt: cardAlt }}
      extend={{
        link: [
          { rel: "icon", href: "/favicon.ico", sizes: "16x16 32x32 48x48" },
          { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
        ],
      }}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main>
      <picture>
        <source srcset="/krusty.avif" type="image/avif" />
        <img class="mascot" src="/krusty.png" alt="krusty, a crab mascot" width="240" height="156" fetchpriority="high" />
      </picture>
      <h1>krusty</h1>
      <p class="tag">A Kotlin compiler written in Rust.</p>
      <p>
        Built to be a drop-in replacement for <code>kotlinc</code> on the JVM. For the Kotlin subset it supports, it accepts <code>kotlinc</code>'s command-line flags and aims to emit <code>.class</code> files byte-for-byte identical to <code>kotlinc</code>'s, from a single native binary. Three badges measure it against the applicable cases of Kotlin's own <code>codegen/box</code> test suite: JVM runtime conformance, JVM byte equality, and Native runtime conformance.
      </p>
      <p class="badges">
        <img src={badge("krusty-kotlin.json")} alt="Latest supported Kotlin version" height="20" />
        <img src={badge("krusty-conformance.json")} alt="Kotlin conformance: share of applicable codegen/box cases whose box() returns OK" height="20" />
        <img src={badge("krusty-jvm-byte-equality.json")} alt="JVM byte equality: matching leading .class bytes against kotlinc across the same codegen/box cases" height="20" />
        <img src={badge("krusty-native-conformance.json")} alt="Native conformance: share of applicable Native codegen/box cases whose box() returns OK" height="20" />
      </p>
      <p>
        <a href={`${repo}/releases/latest`}>Download</a> · <a href={repo}>GitHub</a> · <a href="/metrics/">Metrics</a> · <a href="https://github.com/sponsors/qnox">Sponsor</a>
      </p>

      <h2>Install</h2>
      <p>
        Download <code>krusty</code> for Linux, macOS or Windows from the <a href={`${repo}/releases/latest`}>latest release</a> and put it on your <code>PATH</code>. krusty needs no JVM to run, but reads the class library of an installed JDK.
      </p>

      <h2>Usage</h2>
      <pre><code>krusty src/ -d out/                          # compile to a class directory
krusty src/ -d mylib.jar -module-name mylib  # or to a jar
krusty -cp deps.jar:classes/ App.kt -d out/  # with a classpath</code></pre>

      <h2>Features</h2>
      <ul>
        <li><strong>kotlinc-compatible command line</strong> for the supported subset, output to a class directory or a jar.</li>
        <li><strong>Byte-level fidelity.</strong> Every change is diffed against the real <code>kotlinc</code>, and every build runs JetBrains' <code>codegen/box</code> suite.</li>
        <li><strong>Low memory.</strong> On our multi-module benchmark, about a third of the peak memory of the GraalVM-native <code>kotlinc</code>.</li>
        <li><strong>Build systems and compiler plugins</strong> listed below: Gradle, the Kotlin Toolchain, the Kotlin Build Tools API and Bazel; kotlinx.serialization, all-open, no-arg, sam-with-receiver and KSP.</li>
        <li><strong>Editor support.</strong> <code>krusty-lsp</code> language server, with a <a href={`${repo}/blob/master/editors/zed/README.md`}>Zed extension</a>.</li>
      </ul>

      <h2 id="support">Supported build systems and compiler plugins</h2>
      <p>
        krusty targets every Kotlin release listed in <a href={`${repo}/blob/master/kotlin-versions`}><code>kotlin-versions</code></a>; the badge above shows the newest. On the command line, anything not listed here fails the build with an error instead of being skipped; the Gradle plugin reports it and leaves that compile task to kotlinc.
      </p>
      <h3>Build systems</h3>
      <table>
        <thead><tr><th>Build system</th><th>Support</th></tr></thead>
        <tbody>
          <tr><td>Command line</td><td>kotlinc-compatible flags for the supported subset; output to a class directory or a jar. Compiler plugins come in through <code>-Xplugin</code>/<code>-P</code>/<code>-Xcompiler-plugin</code> as for kotlinc.</td></tr>
          <tr><td>Gradle</td><td><code>id("dev.krustythecompiler")</code> plugin, shipped as <code>krusty-gradle-plugin-&lt;version&gt;.zip</code> in each <a href={`${repo}/releases/latest`}>release</a>. Replaces Kotlin/JVM compile tasks of source sets and of Android variants (AGP 9's built-in Kotlin or <code>kotlin("android")</code>, with android.jar, Java sources and generated <code>R</code>/<code>BuildConfig</code> taken from the variant); validated with Gradle 7.6.3, 8.14.3, 9.5.0 and 9.7.0. <code>kotlin-dsl</code> builds such as <code>buildSrc</code> and compile tasks outside a source set stay with kotlinc, logged per task.</td></tr>
          <tr><td>Kotlin Toolchain (<code>project.yaml</code>/<code>module.yaml</code>)</td><td><code>krusty-toolchain</code>, built from source, as a drop-in for JetBrains' <code>kotlin</code> command: <code>show modules</code>, <code>show settings</code>, <code>show dependencies</code> and <code>task :&lt;module&gt;:compileJvm</code>. JVM modules only; a module with Java sources, a compiler setting it does not pass yet or an artifact to download is refused by name. See <a href={`${repo}/blob/master/docs/KOTLIN_TOOLCHAIN.md`}>docs/KOTLIN_TOOLCHAIN.md</a>.</td></tr>
          <tr><td>Kotlin Build Tools API</td><td><code>krusty-build-tools-&lt;version&gt;-kotlin-&lt;kotlin&gt;.jar</code> in each release, one per supported Kotlin version, stands in for <code>kotlin-build-tools-impl</code> in a build tool that loads the API from a classpath (JetBrains' Kotlin Toolchain among them). JVM toolchain and in-process execution only. See <a href={`${repo}/blob/master/tools/krusty-build-tools/README.md`}>tools/krusty-build-tools</a>.</td></tr>
          <tr><td>Bazel</td><td><code>krusty_jvm_library</code> rule from the <code>krusty</code> Bazel module each release publishes, which brings the release's compiler as a toolchain per host, and a <code>--persistent_worker</code> speaking intellij-community's <code>jvm-inc-builder</code> vocabulary. The worker accepts no compiler plugins. See <a href={`${repo}/blob/master/tools/krusty-bazel/README.md`}>tools/krusty-bazel/README.md</a>.</td></tr>
          <tr><td>Maven</td><td>Not supported.</td></tr>
        </tbody>
      </table>
      <h3>Compiler plugins</h3>
      <p>
        krusty cannot run kotlinc's FIR/IR plugin jars. It reimplements the plugins below natively and selects them from the same jar and options kotlinc receives, so a build switches compilers without changing its plugin configuration.
      </p>
      <table>
        <thead><tr><th>Plugin</th><th>Support</th></tr></thead>
        <tbody>
          <tr><td>kotlinx.serialization</td><td>Supported. Conformance is measured against the plugin's own box-test corpus.</td></tr>
          <tr><td>all-open (<code>plugin.allopen</code>, <code>plugin.spring</code>, <code>plugin.jpa</code>)</td><td>Supported, with the <code>spring</code> and <code>jpa</code> presets.</td></tr>
          <tr><td>no-arg (<code>plugin.noarg</code>, <code>plugin.jpa</code>)</td><td>Supported, with the <code>jpa</code> preset; <code>invokeInitializers=true</code> is not implemented.</td></tr>
          <tr><td>sam-with-receiver</td><td>Supported.</td></tr>
          <tr><td>KSP (KSP2)</td><td>Supported through a build system: under Gradle, KSP's own <code>kspKotlin</code> task runs the processors and krusty compiles what they generate (KSP's Gradle plugin needs Gradle 8 or newer); under the Kotlin Toolchain, processors from Maven artifacts run before the module compiles, but only their generated classes and resources are picked up; a processor that generates Kotlin or Java sources fails the module for now. The plain command line has no codegen host and rejects the KSP plugin.</td></tr>
          <tr><td>kapt</td><td>Supported under Gradle: kapt's own tasks generate stubs and run the annotation processors with kotlinc, and krusty compiles the module after them. kapt's jar alone, which the Kotlin Gradle plugin passes to every compile of a kapt project, changes nothing; kapt options on the command line fail with an error.</td></tr>
          <tr><td>Compose, Parcelize, assignment and every other FIR/IR plugin</td><td>Not supported. The command line fails with an error. The Gradle plugin reports the unsupported plugin and leaves that compile task to kotlinc, so the build still succeeds.</td></tr>
          <tr><td>Kotlin scripts (<code>.kts</code>)</td><td>Not supported.</td></tr>
        </tbody>
      </table>

      <h2>Status</h2>
      <p>krusty compiles plain Kotlin/JVM code today, through the build systems and with the compiler plugins listed above.</p>

      <h2>Roadmap</h2>
      <ul>
        <li>100% JVM conformance with kotlinc</li>
        <li>Kotlin/Native</li>
        <li>Kotlin/Wasm</li>
        <li>Compose</li>
      </ul>

      <h2>Sponsor</h2>
      <p>
        If krusty saves your team build time or CI money, please consider sending part of it back through <a href="https://github.com/sponsors/qnox">GitHub Sponsors</a>.
      </p>
    </main>
    <footer>
      Apache-2.0 · <a href={repo}>github.com/qnox/krusty</a> · News: <a href={news}>{xHandle} on X</a> · Kotlin is a trademark of JetBrains; krusty is an independent project.
    </footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --fg: #1b1a1f; --muted: #5d5a66; --bg: #fff; --code: #f3f1f6; --accent: #7f52ff; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #ecebf0; --muted: #a09cab; --bg: #131217; --code: #201e27; --accent: #a78bff; }
  }
  body { margin: 0 auto; max-width: 720px; padding: 32px 16px; background: var(--bg); color: var(--fg); font: 17px/1.6 system-ui, sans-serif; }
  .mascot { display: block; width: 240px; height: auto; margin: 0 0 8px -8px; }
  h1 { font-size: 40px; margin: 0; }
  .tag { font-size: 22px; margin: 0 0 16px; color: var(--muted); }
  h2 { margin-top: 36px; font-size: 22px; }
  a { color: var(--accent); }
  code, pre { font: 14.5px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  p code, li code { background: var(--code); padding: 1px 4px; border-radius: 4px; }
  pre { background: var(--code); padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
  .badges img { margin-right: 6px; vertical-align: middle; }
  footer { margin-top: 48px; font-size: 14px; color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: 15px; }
  th, td { text-align: left; vertical-align: top; padding: 6px 8px; border-bottom: 1px solid var(--code); }
  td:first-child { min-width: 8em; }
  h3 { margin-top: 24px; font-size: 18px; }
</style>
