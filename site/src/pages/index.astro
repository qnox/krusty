---
const repo = "https://github.com/qnox/krusty";
const title = "krusty: a Kotlin compiler written in Rust";
const description =
  "krusty is a Kotlin compiler written in Rust. Built as a drop-in replacement for kotlinc on the JVM: for the supported Kotlin subset, kotlinc-compatible flags and .class files that aim to be byte-for-byte identical to kotlinc's.";
const badge = (file: string) =>
  `https://img.shields.io/endpoint?url=https%3A%2F%2Fgist.githubusercontent.com%2Fqnox%2Fdec8149bc4f43b203d6cc9adc14f2026%2Fraw%2F${file}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "krusty",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: Astro.site?.href,
  codeRepository: repo,
  downloadUrl: `${repo}/releases/latest`,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site?.href} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site?.href} />
    <meta property="og:image" content={new URL("/krusty.png", Astro.site).href} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main>
      <picture>
        <source srcset="/krusty.avif" type="image/avif" />
        <img class="mascot" src="/krusty.png" alt="krusty, a crab mascot" width="240" height="156" fetchpriority="high" />
      </picture>
      <h1>krusty</h1>
      <p class="tag">A Kotlin compiler written in Rust.</p>
      <p>
        Built to be a drop-in replacement for <code>kotlinc</code> on the JVM. For the Kotlin subset it supports, it accepts <code>kotlinc</code>'s command-line flags and aims to emit <code>.class</code> files byte-for-byte identical to <code>kotlinc</code>'s, from a single native binary. The conformance badge shows how much of Kotlin's own test suite it passes today.
      </p>
      <p class="badges">
        <img src={badge("krusty-kotlin.json")} alt="Latest supported Kotlin version" height="20" />
        <img src={badge("krusty-conformance.json")} alt="Kotlin codegen/box conformance" height="20" />
      </p>
      <p>
        <a href={`${repo}/releases/latest`}>Download</a> · <a href={repo}>GitHub</a> · <a href="https://github.com/sponsors/qnox">Sponsor</a>
      </p>

      <h2>Install</h2>
      <p>
        Download <code>krusty</code> for Linux, macOS or Windows from the <a href={`${repo}/releases/latest`}>latest release</a> and put it on your <code>PATH</code>. krusty needs no JVM to run, but reads the class library of an installed JDK.
      </p>

      <h2>Usage</h2>
      <pre><code>krusty src/ -d out/                          # compile to a class directory
krusty src/ -d mylib.jar -module-name mylib  # or to a jar
krusty -cp deps.jar:classes/ App.kt -d out/  # with a classpath</code></pre>

      <h2>Features</h2>
      <ul>
        <li><strong>kotlinc-compatible command line</strong> for the supported subset, output to a class directory or a jar.</li>
        <li><strong>Byte-level fidelity.</strong> Every change is diffed against the real <code>kotlinc</code>, and every build runs JetBrains' <code>codegen/box</code> suite.</li>
        <li><strong>Low memory.</strong> On our multi-module benchmark, about a third of the peak memory of the GraalVM-native <code>kotlinc</code>.</li>
        <li><strong>kotlinx.serialization and KSP.</strong></li>
        <li><strong>Bazel</strong> persistent worker support.</li>
        <li><strong>Editor support.</strong> <code>krusty-lsp</code> language server, with a <a href={`${repo}/blob/master/editors/zed/README.md`}>Zed extension</a>.</li>
      </ul>

      <h2>Status</h2>
      <p>krusty compiles plain Kotlin/JVM code today. Not supported yet:</p>
      <ul>
        <li>Gradle and Maven integration (use the command line or Bazel)</li>
        <li>Compose, kapt and compiler plugins other than kotlinx.serialization</li>
        <li>Kotlin scripts (<code>.kts</code>)</li>
      </ul>

      <h2>Roadmap</h2>
      <ul>
        <li>100% JVM conformance with kotlinc</li>
        <li>Gradle integration</li>
        <li>Kotlin/Native</li>
        <li>Kotlin/Wasm</li>
        <li>Compose</li>
      </ul>

      <h2>Sponsor</h2>
      <p>
        If krusty saves your team build time or CI money, please consider sending part of it back through <a href="https://github.com/sponsors/qnox">GitHub Sponsors</a>.
      </p>
    </main>
    <footer>
      Apache-2.0 · <a href={repo}>github.com/qnox/krusty</a> · Kotlin is a trademark of JetBrains; krusty is an independent project.
    </footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --fg: #1b1a1f; --muted: #5d5a66; --bg: #fff; --code: #f3f1f6; --accent: #7f52ff; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #ecebf0; --muted: #a09cab; --bg: #131217; --code: #201e27; --accent: #a78bff; }
  }
  body { margin: 0 auto; max-width: 720px; padding: 32px 16px; background: var(--bg); color: var(--fg); font: 17px/1.6 system-ui, sans-serif; }
  .mascot { display: block; width: 240px; height: auto; margin: 0 0 8px -8px; }
  h1 { font-size: 40px; margin: 0; }
  .tag { font-size: 22px; margin: 0 0 16px; color: var(--muted); }
  h2 { margin-top: 36px; font-size: 22px; }
  a { color: var(--accent); }
  code, pre { font: 14.5px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  p code, li code { background: var(--code); padding: 1px 4px; border-radius: 4px; }
  pre { background: var(--code); padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
  .badges img { margin-right: 6px; vertical-align: middle; }
  footer { margin-top: 48px; font-size: 14px; color: var(--muted); }
</style>
