Defaults that follow another setting, and the ones derived from it.
--- module.yaml
product: jvm/lib
settings:
  jvm:
    jdk:
      version: 21
  kotlin:
    version: 2.4.0
  publishing:
    group: org.example
    pom:
      scm:
        url: https://example.org/repo
--- expected
--- settings
settings@jvm:
  compose:
    enabled: false  # default
    experimental:
      hotReload:
        version: 1.2.0  # default
    resources:
      exposedAccessors: false  # default
      nameOfResClass: Res  # default
      packageName:   # default
    version: 1.12.1  # default
  java:
    annotationProcessing:
      processorOptions: {}  # default
      processors: []  # default
    compileIncrementally: false  # default
    freeCompilerArgs: []  # default
  junit: junit-5  # default
  jvm:
    jdk:
      acknowledgedLicenses: []  # default
      distributions: null  # default
      selectionMode: auto  # default
      version: 21  # module.yaml
    release: 21  # default, from ${jdk.version} @ module.yaml
    runtimeClasspathMode: jars  # default
    storeParameterNames: false  # default
    test:
      extraEnvironment: {}  # default
      freeJvmArgs: []  # default
      junitPlatformVersion: 6.1.3  # default
      systemProperties: {}  # default
  kotlin:
    allOpen:
      annotations: null  # default
      enabled: false  # default
      presets: null  # default
    allWarningsAsErrors: false  # default
    apiVersion: null  # default, from ${languageVersion}
    compileIncrementally: true  # default, based on ${version}: enabled for Kotlin compiler >= 2.4.0 @ module.yaml
    compilerPlugins: []  # default
    dataframe:
      enabled: false  # default
      version: 1.0.0-rc01  # default
    explicitApi: disable  # default
    freeCompilerArgs: null  # default
    ksp:
      processorOptions: {}  # default
      processors: []  # default
      version: 2.3.12  # default
    languageFeatures: null  # default
    languageVersion: null  # default
    noArg:
      annotations: null  # default
      enabled: false  # default
      invokeInitializers: false  # default
      presets: null  # default
    optIns: null  # default
    powerAssert:
      enabled: false  # default
      functions:
        - kotlin.assert  # default
    progressiveMode: false  # default
    rpc:
      annotationTypeSafetyEnabled: true  # default
      applyBom: true  # default
      enabled: false  # default
      version: 0.10.4  # default
    serialization:
      enabled: false  # default, based on ${format}: enabled when specified
      format: null  # default
      version: 1.11.0  # default
    suppressWarnings: false  # default
    verbose: false  # default
    version: 2.4.0  # module.yaml
  ktor:
    applyBom: true  # default
    enabled: false  # default
    version: 3.6.0  # default
  lombok:
    enabled: false  # default
    version: 1.18.48  # default
  publishing:
    artifactId: null  # default, from ${name}
    checksums:
      - md5  # default
      - sha1  # default
    enabled: false  # default
    group: org.example  # module.yaml
    mavenCentral:
      enabled: false  # default
      publishingMode: manual  # default
    name: null  # default
    pom:
      description: null  # default
      developers: []  # default
      licenses: []  # default
      name: null  # default
      scm:
        connection: scm:git:https://example.org/repo  # default, based on ${url}: SCM connection URL from repo URL @ module.yaml
        developerConnection: scm:git:https://example.org/repo  # default, based on ${url}: SCM developer connection URL from repo URL @ module.yaml
        url: https://example.org/repo  # module.yaml
      url: null  # default
    publishSources: false  # default
    signArtifacts: false  # default
    version: null  # default
  springBoot:
    applyBom: true  # default
    enabled: false  # default
    version: 4.1.1  # default

