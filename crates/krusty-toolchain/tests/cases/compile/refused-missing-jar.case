An artifact whose metadata is in a repository but whose file is not would be downloaded by the
toolchain; krusty-toolchain does not download artifacts.
--- task
:app:compileJvm
--- project.yaml
modules:
  - app
--- app/module.yaml
product: jvm/app
repositories:
  - mavenLocal
dependencies:
  - org.example:present:1.0
  - org.example:absent-jar:1.0
--- app/src/main.kt
fun main() = Unit
