Kotlin serialization adds its runtime library to the dependencies and the serialization compiler
plugin of the module's Kotlin version to the compilation, from the repository that holds it.
--- task
:app:compileJvm
--- project.yaml
modules:
  - app
--- app/module.yaml
product: jvm/lib
repositories:
  - mavenLocal
settings:
  kotlin:
    serialization: enabled
--- app/src/Model.kt
@kotlinx.serialization.Serializable
class Model(val name: String)
--- m2/org/jetbrains/kotlin/kotlin-serialization-compiler-plugin-embeddable/2.4.20/kotlin-serialization-compiler-plugin-embeddable-2.4.20.pom
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jetbrains.kotlin</groupId>
  <artifactId>kotlin-serialization-compiler-plugin-embeddable</artifactId>
  <version>2.4.20</version>
</project>
