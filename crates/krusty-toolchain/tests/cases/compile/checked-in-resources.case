A plugin that adds a resource directory a task provides: a module whose only resources it adds
puts its resources output on the classpath of the modules that compile against it.
--- task
:app:compileJvm
--- project.yaml
modules:
  - app
  - lib
  - tools/pregenerated
plugins:
  - ./tools/pregenerated
--- tools/pregenerated/module.yaml
product: jvm/amper-plugin
repositories:
  - mavenLocal
--- tools/pregenerated/plugin.yaml
tasks:
  declare:
    action: !org.example.build.declareResources
      resourceDir: ${module.rootDir}/generated-resources
generated:
  resources:
    - directory: ${tasks.declare.action.resourceDir}
--- tools/pregenerated/src/declareResources.kt
package org.example.build

import org.jetbrains.amper.plugins.Output
import org.jetbrains.amper.plugins.TaskAction
import java.nio.file.Path
import kotlin.io.path.isDirectory

@TaskAction
fun declareResources(@Output resourceDir: Path) {
    check(resourceDir.isDirectory()) { "Missing pre-generated resources: $resourceDir" }
}
--- lib/module.yaml
product: jvm/lib
repositories:
  - mavenLocal
plugins:
  pregenerated: enabled
--- lib/src/Lib.kt
object Lib
--- lib/generated-resources/META-INF/build-info.properties
version=1
--- app/module.yaml
product: jvm/app
repositories:
  - mavenLocal
dependencies:
  - ../lib
--- app/src/main.kt
fun main() = println(Lib)
--- m2/org/jetbrains/amper/amper-extensibility-api/0.13.0/amper-extensibility-api-0.13.0.pom
<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jetbrains.amper</groupId>
  <artifactId>amper-extensibility-api</artifactId>
  <version>0.13.0</version>
</project>
--- m2/org/jetbrains/amper/amper-extensibility-api/0.13.0/amper-extensibility-api-0.13.0.jar
The plugin API the distribution ships replaces this when the toolchain runs.
--- toolchain-plugin-module
pregenerated
