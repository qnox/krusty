A module's compile classpath holds the modules and artifacts it depends on directly and what they
export, transitively, exported dependencies first; what they do not export is compiled before it
but stays off its classpath. The modules use the Maven-like layout; a module with resources has its
resources output right after its compiled output.
--- task
:app:compileJvm
--- project.yaml
modules:
  - app
  - base
  - hidden
  - mid
--- app/module.yaml
product: jvm/app
layout: maven-like
repositories:
  - mavenLocal
dependencies:
  - ../mid
--- app/src/main/kotlin/app/Main.kt
package app

fun main() = println(base.Base().name)
--- mid/module.yaml
product: jvm/lib
layout: maven-like
repositories:
  - mavenLocal
dependencies:
  - org.example:mid-impl:1.0
  - ../base: exported
  - org.example:mid-api:1.0: exported
--- mid/src/main/kotlin/mid/Mid.kt
package mid

class Mid
--- base/module.yaml
product: jvm/lib
layout: maven-like
repositories:
  - mavenLocal
dependencies:
  - ../hidden
  - org.example:base-api:1.0: exported
--- base/src/main/kotlin/base/Base.kt
package base

class Base(val name: String = "base")
--- base/src/main/resources/base.properties
name=base
--- hidden/module.yaml
product: jvm/lib
layout: maven-like
repositories:
  - mavenLocal
--- hidden/src/main/kotlin/hidden/Hidden.kt
package hidden

class Hidden
--- m2/org/example/mid-impl/1.0/mid-impl-1.0.pom
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>mid-impl</artifactId>
  <version>1.0</version>
</project>
--- m2/org/example/mid-impl/1.0/mid-impl-1.0.jar
--- m2/org/example/mid-api/1.0/mid-api-1.0.pom
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>mid-api</artifactId>
  <version>1.0</version>
</project>
--- m2/org/example/mid-api/1.0/mid-api-1.0.jar
--- m2/org/example/base-api/1.0/base-api-1.0.pom
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>base-api</artifactId>
  <version>1.0</version>
</project>
--- m2/org/example/base-api/1.0/base-api-1.0.jar
--- krusty-argv
-Xjdk-release=25
-jdk-home=<directory>/jdk
-classpath=<directory>/home/.m2/repository/org/jetbrains/kotlin/kotlin-stdlib/2.4.20/kotlin-stdlib-2.4.20.jar:<directory>/home/.m2/repository/org/jetbrains/annotations/13.0/annotations-13.0.jar
-no-stdlib
-module-name=hidden
-Xkotlin-reference-version=2.4.20
-d
<directory>/project/build/artifacts/CompiledJvmArtifact/hiddenjvm/kotlin-output
<directory>/project/hidden/src/main/kotlin/hidden/Hidden.kt
