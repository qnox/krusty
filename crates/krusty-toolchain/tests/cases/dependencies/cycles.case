  <groupId>org.example</groupId>
  <artifactId>a</artifactId>
  <version>1.0</version>
  <dependencies>
      <dependency><groupId>org.example</groupId><artifactId>b</artifactId><version>1.0</version></dependency>
  </dependencies>
</project>
