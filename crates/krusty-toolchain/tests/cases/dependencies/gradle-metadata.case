A library that publishes Gradle module metadata is read from its JVM variants: the variant for
each classpath, a platform it depends on, the module its root points at, and its constraints.
--- module.yaml
product: jvm/app
repositories:
  - mavenLocal
dependencies:
  - org.example:multi:1.0
--- m2/org/example/multi/1.0/multi-1.0.pom
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>multi</artifactId>
  <version>1.0</version>
  <!-- do_not_remove: published-with-gradle-metadata -->
</project>
--- m2/org/example/multi/1.0/multi-1.0.module
{
  "formatVersion": "1.1",
  "component": {
    "group": "org.example",
    "module": "multi",
    "version": "1.0"
  },
  "createdBy": {
    "gradle": {
      "version": "8.10"
    }
  },
  "variants": [
    {
      "name": "jvmApiElements-published",
      "attributes": {
        "org.gradle.category": "library",
        "org.gradle.usage": "java-api",
        "org.gradle.libraryelements": "jar",
        "org.gradle.jvm.environment": "standard-jvm",
        "org.jetbrains.kotlin.platform.type": "jvm"
      },
      "available-at": {
        "url": "../../multi-jvm/1.0/multi-jvm-1.0.module",
        "group": "org.example",
        "module": "multi-jvm",
        "version": "1.0"
      }
    },
    {
      "name": "jvmRuntimeElements-published",
      "attributes": {
        "org.gradle.category": "library",
        "org.gradle.usage": "java-runtime",
        "org.gradle.libraryelements": "jar",
        "org.gradle.jvm.environment": "standard-jvm",
        "org.jetbrains.kotlin.platform.type": "jvm"
      },
      "available-at": {
        "url": "../../multi-jvm/1.0/multi-jvm-1.0.module",
        "group": "org.example",
        "module": "multi-jvm",
        "version": "1.0"
      }
    },
    {
      "name": "metadataApiElements",
      "attributes": {
        "org.gradle.category": "library",
        "org.gradle.usage": "kotlin-metadata",
        "org.jetbrains.kotlin.platform.type": "common"
      },
      "dependencies": [
        {
          "group": "org.example",
          "module": "common-only",
          "version": {
            "requires": "1.0"
          }
        }
      ]
    }
  ]
}
