          "group": "org.example",
          "module": "api-dep",
          "version": {
            "requires": "1.0"
          }
        },
        {
          "group": "org.example",
          "module": "managed"
        },
        {
          "group": "org.example",
          "module": "rt-dep",
          "version": {
