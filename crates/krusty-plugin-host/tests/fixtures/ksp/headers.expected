w: [ksp] CLASS headers.Middle modifiers=OPEN typeParameters=[E qualified=headers.Middle.E variance=COVARIANT reified=false bounds=kotlin.CharSequence?] supertypes=headers.Base<kotlin.collections.List<headers.Middle.E [type parameter of headers.Middle]>, kotlin.String>, kotlin.Comparable<headers.Middle<*>> star=headers.Middle<*> starText=Middle<*>
w: [ksp] INTERFACE headers.Shape modifiers=SEALED typeParameters=[S qualified=headers.Shape.S variance=INVARIANT reified=false bounds=kotlin.Number & kotlin.Comparable<headers.Shape.S [type parameter of headers.Shape]>] supertypes=headers.Named star=headers.Shape<*> starText=Shape<*>
w: [ksp] CLASS headers.Hidden modifiers=PRIVATE typeParameters=[] supertypes=headers.Shape<kotlin.Int> star=headers.Hidden starText=Hidden
w: [ksp] ANNOTATION_CLASS headers.Marker modifiers=ANNOTATION,INTERNAL typeParameters=[] supertypes=kotlin.Annotation star=headers.Marker starText=Marker
w: [ksp] ENUM_CLASS headers.Color modifiers=ENUM typeParameters=[] supertypes=kotlin.Enum<headers.Color> star=headers.Color starText=Color
w: [ksp] CLASS headers.Outer modifiers= typeParameters=[] supertypes=kotlin.Any star=headers.Outer starText=Outer
w: [ksp] INTERFACE headers.Action modifiers=FUN typeParameters=[] supertypes=kotlin.Function0<kotlin.Unit> star=headers.Action starText=Action
w: [ksp] CLASS headers.Outer.In modifiers=INNER typeParameters=[X qualified=headers.Outer.In.X variance=INVARIANT reified=false bounds=kotlin.Any?] supertypes=headers.Named, kotlin.Comparable<headers.Outer.In.X [type parameter of headers.Outer.In]?> star=headers.Outer.In<*> starText=In<*>
w: [ksp] OBJECT headers.Outer.Single modifiers=DATA typeParameters=[] supertypes=kotlin.Any star=headers.Outer.Single starText=Single
