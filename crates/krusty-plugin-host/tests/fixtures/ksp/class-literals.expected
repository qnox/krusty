# What KSP2 2.3.12 (KSPJvmMain) logs with Annotations.kt over class-literals/Use.kt, with
# class-literals/dependency/ on the classpath (ClassDefaults.java built by javac, KotlinDefaults.kt by
# kotlinc for this record): a class literal read from a class file names the Kotlin classifier its JVM
# class maps to (a primitive or its wrapper, `void`, a primitive array, a mutable collection) with no
# type arguments, while one written in source keeps a star for each type parameter.
w: [ksp] jc.SourceDefaults.none accessors get=SYNTHETIC/FINAL,PUBLIC set=null
w: [ksp] jc.SourceDefaults.list accessors get=SYNTHETIC/FINAL,PUBLIC set=null
w: [ksp] jc.SourceDefaults.array accessors get=SYNTHETIC/FINAL,PUBLIC set=null
w: [ksp] jc.Plain @ClassDefaults=javaclasses.ClassDefaults target=null origin=KOTLIN (none=type kotlin.Unit SYNTHETIC, primitive=type kotlin.Int SYNTHETIC, boxed=type kotlin.Int SYNTHETIC, text=type kotlin.String SYNTHETIC, list=type kotlin.collections.MutableList SYNTHETIC, array=type kotlin.IntArray SYNTHETIC, objects=type kotlin.Array<INVARIANT kotlin.String> SYNTHETIC, bounded=type kotlin.Long SYNTHETIC) defaults(none=type kotlin.Unit, primitive=type kotlin.Int, boxed=type kotlin.Int, text=type kotlin.String, list=type kotlin.collections.MutableList, array=type kotlin.IntArray, objects=type kotlin.Array<INVARIANT kotlin.String>, bounded=type kotlin.Long)
w: [ksp] jc.Written @ClassDefaults=javaclasses.ClassDefaults target=null origin=KOTLIN (none=type kotlin.Unit KOTLIN, primitive=type kotlin.Int KOTLIN, list=type kotlin.collections.MutableList<STAR *> KOTLIN, boxed=type kotlin.Int SYNTHETIC, text=type kotlin.String SYNTHETIC, array=type kotlin.IntArray SYNTHETIC, objects=type kotlin.Array<INVARIANT kotlin.String> SYNTHETIC, bounded=type kotlin.Long SYNTHETIC) defaults(none=type kotlin.Unit, primitive=type kotlin.Int, boxed=type kotlin.Int, text=type kotlin.String, list=type kotlin.collections.MutableList, array=type kotlin.IntArray, objects=type kotlin.Array<INVARIANT kotlin.String>, bounded=type kotlin.Long)
w: [ksp] jc.FromKotlin @KotlinDefaults=kotlinclasses.KotlinDefaults target=null origin=KOTLIN (none=type kotlin.Unit SYNTHETIC, primitive=type kotlin.Int SYNTHETIC, list=type kotlin.collections.MutableList SYNTHETIC, mutable=type kotlin.collections.MutableMap SYNTHETIC, array=type kotlin.IntArray SYNTHETIC, objects=type kotlin.Array<INVARIANT kotlin.String> SYNTHETIC, bounded=type kotlin.Long SYNTHETIC) defaults(none=type kotlin.Unit, primitive=type kotlin.Int, list=type kotlin.collections.MutableList, mutable=type kotlin.collections.MutableMap, array=type kotlin.IntArray, objects=type kotlin.Array<INVARIANT kotlin.String>, bounded=type kotlin.Long)
