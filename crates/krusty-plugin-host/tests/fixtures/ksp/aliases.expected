# What KSP2 2.3.12 (KSPJvmMain) logs with Members.kt over aliases/: every declaration with its
# modifiers, type parameters, supertypes and types, a type that names a type alias resolving to it.
w: [ksp] ANNOTATION_CLASS aliases.Kept modifiers=ANNOTATION typeParameters= supertypes=kotlin.Annotation
w: [ksp]   fun <init> kind=MEMBER abstract=false modifiers=FINAL,PUBLIC typeParameters= receiver=null (): aliases.Kept
w: [ksp] KSTypeAlias Plain
w: [ksp] KSTypeAlias KeptString
w: [ksp] KSTypeAlias MaybeText
w: [ksp] KSTypeAlias Names
w: [ksp] KSTypeAlias Callback
w: [ksp] CLASS aliases.Aliases modifiers= typeParameters= supertypes=kotlin.Any
w: [ksp]   property plain mutable=false backingField=true modifiers=: aliases.Plain
w: [ksp]   property nullablePlain mutable=false backingField=true modifiers=: aliases.Plain?
w: [ksp]   property kept mutable=false backingField=true modifiers=: aliases.KeptString
w: [ksp]   property maybe mutable=false backingField=true modifiers=: aliases.MaybeText
w: [ksp]   property names mutable=false backingField=true modifiers=: aliases.Names
w: [ksp]   property callback mutable=false backingField=true modifiers=: aliases.Callback
