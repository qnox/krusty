w: [ksp]   property mapped mutable=false backingField=true modifiers=: kotlin.collections.Map<aliases.Plain, aliases.Names>
w: [ksp]   fun convert kind=MEMBER abstract=false modifiers= typeParameters= receiver=null (input: aliases.Plain vararg=false default=false, callback: aliases.Callback vararg=false default=false): aliases.Names
w: [ksp]   fun <init> kind=MEMBER abstract=false modifiers=FINAL typeParameters= receiver=null (plain: aliases.Plain vararg=false default=false, nullablePlain: aliases.Plain? vararg=false default=false, kept: aliases.KeptString vararg=false default=false, maybe: aliases.MaybeText vararg=false default=false, names: aliases.Names vararg=false default=false, callback: aliases.Callback vararg=false default=false, nested: kotlin.collections.List<aliases.KeptString> vararg=false default=false, mapped: kotlin.collections.Map<aliases.Plain, aliases.Names> vararg=false default=false): aliases.Aliases
