diff --git a/build/jvm-rules/krusty_compiler.bzl b/build/jvm-rules/krusty_compiler.bzl
new file mode 100644
index 0000000000..708b799ddb
--- /dev/null
+++ b/build/jvm-rules/krusty_compiler.bzl
@@ -0,0 +1,39 @@
+"""Optional krusty compiler binary, selected by `KRUSTY_BINARY`.
+
+Unset, the repository holds a stub and `KRUSTY_ENABLED` is false, so `jvm_library` keeps the
+JPS builder. Set to an absolute path of a built `krusty` executable and the same rules compile
+Kotlin-only, plugin-free targets with that binary. Java sources, source jars, and compiler
+plugins stay on the JPS builder: krusty has no Java front end and does not load build-supplied
+plugins.
+"""
+
+def _krusty_compiler_impl(rctx):
+    binary = (rctx.getenv("KRUSTY_BINARY") or "").strip()
+    if binary:
+        if not rctx.path(binary).exists:
+            fail("KRUSTY_BINARY does not exist: %s" % binary)
+        rctx.watch(binary)
+        result = rctx.execute(["cp", "-L", binary, "krusty.bin"])
+        if result.return_code != 0:
+            fail("cannot copy KRUSTY_BINARY: %s" % result.stderr)
+        result = rctx.execute(["chmod", "a+x", "krusty.bin"])
+        if result.return_code != 0:
+            fail("cannot mark krusty executable: %s" % result.stderr)
+        enabled = True
+    else:
+        rctx.file(
+            "krusty.bin",
+            "#!/bin/sh\necho 'KRUSTY_BINARY is unset' >&2\nexit 1\n",
+            executable = True,
+        )
+        enabled = False
+
+    rctx.file("defs.bzl", "KRUSTY_ENABLED = %s\n" % enabled)
+    rctx.file("BUILD.bazel", "exports_files([\"krusty.bin\"])\n")
+    return rctx.repo_metadata(reproducible = not enabled)
+
+krusty_compiler = repository_rule(
+    implementation = _krusty_compiler_impl,
+    environ = ["KRUSTY_BINARY"],
+    local = True,
+)
